# Copy this file to .env for local development and replace the placeholders.
POSTGRES_DB=quantara_ai_boq
POSTGRES_USER=quantara
POSTGRES_PASSWORD=replace_with_a_strong_local_password
DATABASE_URL="postgresql://quantara:replace_with_a_strong_local_password@localhost:5432/quantara_ai_boq?schema=public"

# Base URL used to build links inside auth emails (verification, password reset).
APP_BASE_URL="http://localhost:3000"

# Email delivery. "development" (default) logs emails to the console instead
# of sending them. Set to "smtp" to send real email through the SMTP_* config
# below; never commit a real mailbox password here.
EMAIL_PROVIDER=development
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-business-email@example.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM_EMAIL=your-business-email@example.com
SMTP_FROM_NAME="Quantara AI BOQ"

# One-time, explicit platform-owner bootstrap target. The account must already
# exist, be active, and have a verified email. Never put this command in a
# build/deploy hook; run `npm run admin:bootstrap-owner` only when intended.
PLATFORM_OWNER_EMAIL="owner@example.com"

# Seeded development company owner. Set real values before running db:seed;
# the seed falls back to insecure defaults with a warning if these are unset.
DEV_OWNER_EMAIL="owner@quantara.local"
DEV_OWNER_PASSWORD="replace_with_a_strong_dev_password1"
DEV_OWNER_NAME="Quantara Development Owner"

# Encrypts OAuth tokens (ExternalConnection.encryptedCredentialsRef) at rest. Required before
# connecting any integration provider. Generate with: openssl rand -base64 32
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY="replace_with_output_of_openssl_rand_-base64_32"

# Google Drive connector (src/lib/integrations/connectors/google-drive-client.ts). From Google
# Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application). Redirect URI
# must be set to {APP_BASE_URL}/api/integrations/google-drive/callback.
GOOGLE_DRIVE_CLIENT_ID="replace_with_google_oauth_client_id"
GOOGLE_DRIVE_CLIENT_SECRET="replace_with_google_oauth_client_secret"

# Server-only Release 1 voice transcription. Audio is sent directly to the
# OpenAI transcription endpoint and is not stored by Quantara.
OPENAI_API_KEY="replace_with_openai_api_key"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"

# Server-only Arcade infrastructure for allowlisted future connectors. Arcade
# is not a marketplace provider and the API key must never use NEXT_PUBLIC_*.
ARCADE_API_KEY="replace_with_arcade_api_key"
# Optional; defaults to https://api.arcade.dev.
ARCADE_BASE_URL="https://api.arcade.dev"

# STRIPE-1C — Stripe test-mode product/price synchronization only. No
# checkout, no webhook, no payment collection exists in this codebase yet.
# STRIPE_SECRET_KEY must start with sk_test_ — a live key (sk_live_...) is
# refused by src/lib/payments/stripe-client.ts. Never commit a real key here;
# set it directly in the hosting provider's environment variables.
STRIPE_SECRET_KEY="sk_test_replace_with_your_stripe_test_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_your_stripe_test_publishable_key"
STRIPE_MODE=test
