engine-strict=true
package-lock=true
save-exact=true
# TAYQAN-2A — @react-three/fiber@9/@react-three/drei@10 formally require
# react@19 as a peer. The app is deliberately on react@18.3.1 and nothing
# else changes. This isn't a real incompatibility: Next.js 15's own dev/RSC
# runtime already inlines React-19-shaped internals regardless of what's
# declared, which is exactly why @react-three/fiber@8 (targeting real React
# 18) crashes here with "Cannot read properties of undefined (reading
# 'ReactCurrentOwner')" the instant a Canvas mounts — confirmed via
# https://github.com/pmndrs/react-three-fiber/issues/3446, maintainer
# comment. v9 resolves cleanly against what Next 15 actually runs. Without
# this line, a plain `npm install`/`npm ci` (including Vercel's build) fails
# outright on the declared peer conflict despite the runtime combination
# being the one that actually works — verified crash-free in-browser only
# after this upgrade.
legacy-peer-deps=true
