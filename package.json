{
  "name": "quantara-ai-boq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint src tests scripts prisma --ext .js,.mjs,.cjs,.ts,.tsx --max-warnings=0 && eslint next.config.mjs open-next.config.ts playwright.config.ts vitest.config.ts --max-warnings=0",
    "typecheck": "node scripts/run-typecheck.mjs",
    "test": "node scripts/run-test-suite.mjs",
    "test:watch": "node scripts/run-test-suite.mjs --watch",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "admin:bootstrap-owner": "tsx scripts/bootstrap-platform-owner.ts",
    "admin:provision-owner": "tsx scripts/provision-platform-owner.ts",
    "storage:verify-blob": "tsx scripts/verify-vercel-blob-storage.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@arcadeai/arcadejs": "^2.4.1",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.6.1",
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.0.3",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.470.0",
    "nanoid": "^6.0.0",
    "next": "^15.5.22",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.55.0",
    "recharts": "^2.8.0",
    "stripe": "^22.4.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.14.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.22",
    "jszip": "^3.10.1",
    "lighthouse": "^13.4.1",
    "postcss": "8.4.38",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.4",
    "tsx": "^4.19.0",
    "typescript": "5.4.5",
    "vitest": "2.1.9",
    "wrangler": "^4.118.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
