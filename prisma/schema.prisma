  sourcePreviousBoqItem      BOQItem?                @relation("BoqItemSourceChain", fields: [sourcePreviousBoqItemId], references: [id], onDelete: SetNull)
  copiedIntoItems            BOQItem[]               @relation("BoqItemSourceChain")
  copiedByUser               User?                   @relation("BoqItemCopiedByUser", fields: [copiedByUserId], references: [id], onDelete: SetNull)
