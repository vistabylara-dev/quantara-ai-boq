  ELEVATION
  SECTION
  DETAIL_DRAWING
  MATERIAL_SCHEDULE
  FURNITURE_SCHEDULE
  EQUIPMENT_SCHEDULE
  DOOR_SCHEDULE
  WINDOW_SCHEDULE
  FINISH_SCHEDULE
  SUPPLIER_PRICE_LIST
  EXISTING_BOQ
  PRODUCT_CATALOGUE
  SITE_INSPECTION_PHOTO
