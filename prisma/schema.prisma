  updatedAt                     DateTime                   @updatedAt
  company                       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                       Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedByUser                User                       @relation("ProjectFileUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  classificationConfirmedByUser User?                      @relation("ProjectFileClassificationConfirmedByUser", fields: [classificationConfirmedByUserId], references: [id], onDelete: SetNull)
  extractionJobs                 ExtractionJob[]
  extractedTables                 ExtractedTable[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([classification])
  @@index([companyId, checksum])
}

