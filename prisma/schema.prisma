/**
 * Phase 8 — a single unit of background processing work against a
 * ProjectFile (classification, extraction, detection, etc.). Always
 * created before any large/slow processing starts; API route handlers only
 * ever enqueue a job and return, never run the work inline (spec section 1
 * anti-drift rule against synchronous large-file processing in request
 * handlers). Processed by the queue in src/lib/jobs/*.
 */
model ExtractionJob {
  id                  String                @id @default(uuid()) @db.Uuid
  companyId           String                @db.Uuid
  projectId           String                @db.Uuid
  projectFileId       String                @db.Uuid
  engineType          ExtractionEngineType
  provider            String                @default("local")
  status              ExtractionJobStatus   @default(QUEUED)
  progressPercentage  Int                   @default(0)
  currentStep         String?
  startedAt           DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  attempts            Int                   @default(0)
  maximumAttempts     Int                   @default(3)
  configurationJson   Json?
  resultSummaryJson   Json?
  usageMetadataJson   Json?
  errorCode           String?
  errorMessage        String?
  createdByUserId     String                @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectFile         ProjectFile           @relation(fields: [projectFileId], references: [id], onDelete: Cascade)
  createdByUser       User                  @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
  @@index([projectFileId])
  @@index([status])
  @@index([engineType])
}

enum ExtractionEngineType {
  DOCUMENT_CLASSIFICATION
  FILE_PREPROCESSING
  PDF_TEXT_EXTRACTION
  OCR_TEXT_EXTRACTION
  TABLE_EXTRACTION
  TITLE_BLOCK_EXTRACTION
  SCALE_DETECTION
  VECTOR_EXTRACTION
  ROOM_BOUNDARY_DETECTION
  OBJECT_DETECTION
  SYMBOL_DETECTION
  QUANTITY_CALCULATION
  PRODUCT_MATCHING
  PHOTO_ANALYSIS
  FINDINGS_DRAFTING
  REPORT_DRAFTING
  VERIFICATION_GENERATION
}

enum ExtractionJobStatus {
  QUEUED
  RUNNING
  NEEDS_INPUT
  NEEDS_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

/**
 * Phase 8 section 11 — a table/schedule extracted from a source file (CSV,
 * XLSX, or a text-based PDF). `drawingPageId` is included per the spec's
 * field list for a future sub-phase (drawing viewer) that introduces the
 * DrawingPage model; it is a plain nullable id column with no FK constraint
 * yet — the constraint is added once DrawingPage exists, in that sub-phase's
 * own migration, rather than guessing at that model's shape now.
 */
model ExtractedTable {
  id                  String             @id @default(uuid()) @db.Uuid
  companyId           String             @db.Uuid
  projectFileId       String             @db.Uuid
  drawingPageId       String?            @db.Uuid
  sheetName           String?
  title               String?
  tableType           ExtractedTableType @default(UNKNOWN)
  confidence          Decimal            @db.Decimal(5, 2)
  boundingGeometryJson Json?
  sourceReference     String?
  status              ExtractedTableStatus @default(EXTRACTED)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectFile         ProjectFile        @relation(fields: [projectFileId], references: [id], onDelete: Cascade)
  rows                ExtractedTableRow[]

  @@index([companyId])
  @@index([projectFileId])
  @@index([status])
  @@index([tableType])
}

/**
 * A parent row carries the columns shared across a merged/grouped range
 * (e.g. "Element: Foundations", "Concrete: 53 m3" spanning several source
 * rows); its child rows carry only the columns that vary per source row
 * (e.g. reinforcement diameter + quantity) — never a copy of the parent's
 * quantity columns, so summing children never double-counts the parent
 * value (spec section 12).
 */
model ExtractedTableRow {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  extractedTableId   String              @db.Uuid
  rowNumber          Int
  parentRowId        String?             @db.Uuid
  normalizedDataJson Json?
  rawDataJson        Json?
  confidence         Decimal             @db.Decimal(5, 2)
  status             ExtractedTableStatus @default(EXTRACTED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  extractedTable     ExtractedTable      @relation(fields: [extractedTableId], references: [id], onDelete: Cascade)
  parentRow          ExtractedTableRow?  @relation("ExtractedTableRowParent", fields: [parentRowId], references: [id], onDelete: Cascade)
  childRows          ExtractedTableRow[] @relation("ExtractedTableRowParent")
  cells              ExtractedTableCell[]

  @@index([companyId])
  @@index([extractedTableId])
  @@index([parentRowId])
  @@index([status])
}

model ExtractedTableCell {
  id                   String            @id @default(uuid()) @db.Uuid
  companyId            String            @db.Uuid
  extractedTableRowId  String            @db.Uuid
  columnKey            String
  rawValue             String?
  normalizedValue      String?
  confidence           Decimal           @db.Decimal(5, 2)
  sourceCellReference  String?
  boundingGeometryJson Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  extractedTableRow    ExtractedTableRow @relation(fields: [extractedTableRowId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([extractedTableRowId])
}

enum ExtractedTableType {
  SUPPLIER_QUOTATION
  EXISTING_BOQ
  FURNITURE_SCHEDULE
  EQUIPMENT_SCHEDULE
  STRUCTURAL_QUANTITY_SCHEDULE
  DOOR_SCHEDULE
  WINDOW_SCHEDULE
  FINISH_SCHEDULE
  MATERIAL_SCHEDULE
  GENERIC_TABLE
  UNKNOWN
}

enum ExtractedTableStatus {
  EXTRACTED
  NEEDS_REVIEW
  CONFIRMED
  CORRECTED
  REJECTED
}
