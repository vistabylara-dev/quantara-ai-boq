/// INTEGRATIONS-1A — AEC applications and connected data hub foundation.
/// Deliberately four new, standalone tables with no columns added to any
/// existing model (MasterItem/BOQItem lesson from MASTER-BOQ-1A: adding
/// columns to hot, already-queried tables breaks every unscoped query
/// against them the moment the code deploy lands ahead of the migration —
/// entirely new tables carry no such risk, since nothing pre-existing ever
/// queries them). No OAuth, sync, or live connector exists yet in this
/// phase; these are the identity/connection/link/audit records that 1B+
/// will populate.
enum IntegrationConnectionType {
  OAUTH_CLOUD
  PLUGIN_DESKTOP
  API_KEY
  SERVICE_ACCOUNT
  FILE_IMPORT
  WEBHOOK
  COMING_SOON
}

/// Matches the provider card statuses required by the spec — deliberately
/// distinct from ExternalConnectionStatus below (a provider's *general
/// availability* vs. one company's *specific connection health*).
enum IntegrationProviderStatus {
  AVAILABLE
  BETA
  REQUIRES_PLUGIN
  FILE_IMPORT_ONLY
  COMING_SOON
}

enum ExternalConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
  SYNCING
  DEGRADED
  DISCONNECTED
  ERROR
}

enum ProjectIntegrationSyncState {
  NOT_SYNCED
  QUEUED
  SYNCING
  SYNCED
  FAILED
}

enum SynchronizationRunResult {
  SUCCESS
  PARTIAL
  FAILED
}

/// Registry row per provider (e.g. "autodesk", "revit", "procore",
/// "microsoft-365") — id is the same stable string key the code-side
/// provider registry (src/lib/integrations/provider-registry.ts) uses, so
/// ExternalConnection can reference a real row without a separate mapping
/// table. Seeded from that registry; the registry (not this table) is the
/// authoritative source the marketplace UI reads from directly, so the
/// marketplace renders correctly even before this table is seeded.
model IntegrationProvider {
  id                        String                    @id
  providerFamily            String
  displayName               String
  category                  String
  connectionType            IntegrationConnectionType
  status                    IntegrationProviderStatus
  configurationMetadataJson Json?
  isActive                  Boolean                   @default(true)
  sortOrder                 Int                       @default(0)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  externalConnections       ExternalConnection[]
  synchronizationRuns       SynchronizationRun[]

  @@index([providerFamily])
  @@index([category])
  @@index([status])
}

/// One company's connection to one provider. Credentials are never stored
/// here directly — encryptedCredentialsRef is an opaque pointer into a
/// dedicated encrypted secret store (see docs/authentication.md-style
/// design note in the credential-encryption service added alongside the
/// first real connector in 1B); this table only ever holds the reference,
/// grant metadata, and connection health.
model ExternalConnection {
  id                      String                   @id @default(uuid()) @db.Uuid
  companyId               String                   @db.Uuid
  connectedByUserId       String                   @db.Uuid
  providerId              String
  encryptedCredentialsRef String?
  grantedScopesJson       Json?
  providerAccountId       String?
  status                  ExternalConnectionStatus @default(CONNECTED)
  connectedAt             DateTime                 @default(now())
  tokenExpiresAt          DateTime?
  lastSyncAt              DateTime?
  disconnectedAt          DateTime?
  lastErrorCode           String?
  lastErrorMessage        String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedByUser         User                     @relation(fields: [connectedByUserId], references: [id], onDelete: Restrict)
  provider                IntegrationProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  projectIntegrations     ProjectIntegration[]
  synchronizationRuns     SynchronizationRun[]
  integrationEvents       IntegrationEvent[]

  @@index([companyId])
  @@index([providerId])
  @@index([status])
}

/// Links one Quantara project to an external project/hub/folder/file/model/
/// version. Multiple rows per project are expected (e.g. one Autodesk model
/// link + one Procore documents link).
model ProjectIntegration {
  id                   String                      @id @default(uuid()) @db.Uuid
  projectId            String                      @db.Uuid
  externalConnectionId String                      @db.Uuid
  externalAccountId    String?
  externalProjectId    String?
  externalFolderId     String?
  externalFileId       String?
  externalModelId      String?
  externalVersionId    String?
  syncState            ProjectIntegrationSyncState @default(NOT_SYNCED)
  lastSyncedVersionId  String?
  syncSettingsJson     Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  project              Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalConnection   ExternalConnection          @relation(fields: [externalConnectionId], references: [id], onDelete: Cascade)
  synchronizationRuns  SynchronizationRun[]
  integrationEvents    IntegrationEvent[]

  @@index([projectId])
  @@index([externalConnectionId])
}

/// One audit row per synchronization attempt — never overwritten, so sync
/// history is always inspectable (spec: "safe error code/message, audit
/// actor").
model SynchronizationRun {
  id                   String                    @id @default(uuid()) @db.Uuid
  providerId           String
  externalConnectionId String                    @db.Uuid
  projectIntegrationId String                    @db.Uuid
  sourceVersionId      String?
  startedAt            DateTime                  @default(now())
  completedAt          DateTime?
  result               SynchronizationRunResult?
  insertedCount        Int                       @default(0)
  updatedCount         Int                       @default(0)
  skippedCount         Int                       @default(0)
  errorCode            String?
  errorMessage         String?
  actorUserId          String?                   @db.Uuid
  createdAt            DateTime                  @default(now())
  provider             IntegrationProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  externalConnection   ExternalConnection        @relation(fields: [externalConnectionId], references: [id], onDelete: Cascade)
  projectIntegration   ProjectIntegration        @relation(fields: [projectIntegrationId], references: [id], onDelete: Cascade)
  actorUser            User?                     @relation("SynchronizationRunActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectIntegrationId])
  @@index([externalConnectionId])
  @@index([providerId])
}

enum IntegrationEventType {
  CONNECTION_CREATED
  CONNECTION_REFRESHED
  CONNECTION_REAUTH_REQUIRED
  CONNECTION_DISCONNECTED
  CONNECTION_ERROR
  PROJECT_LINKED
  PROJECT_UNLINKED
  SYNC_STARTED
  SYNC_COMPLETED
  SYNC_FAILED
}

/// INTEGRATIONS-1A completion pass — safe, customer-visible operational
/// history ("Connected -> project linked -> synchronization started -> ...")
/// distinct from the app-wide PlatformAuditLog (that log is platform-owner-
/// only and covers admin actions across every feature; this one is scoped
/// to a single company's integrations and is meant to be shown directly to
/// that company's own users). `summary` and `metadataJson` must never
/// contain a token, secret, authorization code, or raw provider payload —
/// enforced by convention at the one write site (integration-event-service.ts),
/// not by the schema.
model IntegrationEvent {
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @db.Uuid
  providerId           String
  externalConnectionId String?              @db.Uuid
  projectIntegrationId String?              @db.Uuid
  eventType            IntegrationEventType
  status               String
  summary              String
  metadataJson         Json?
  actorUserId          String?              @db.Uuid
  createdAt            DateTime             @default(now())
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalConnection   ExternalConnection?  @relation(fields: [externalConnectionId], references: [id], onDelete: SetNull)
  projectIntegration   ProjectIntegration?  @relation(fields: [projectIntegrationId], references: [id], onDelete: SetNull)
  actorUser            User?                @relation("IntegrationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([externalConnectionId])
  @@index([projectIntegrationId])
  @@index([eventType])
}

// ---------------------------------------------------------------------------
// STRIPE-1B — internal commerce product catalogue
// ---------------------------------------------------------------------------
// The authoritative, server-controlled product/price/entitlement catalogue a
// later Stripe integration phase will synchronize against and sell. No
// payment provider is wired to any of this yet — CommercePrice.amountMinor is
// deliberately an integer minor-unit amount (matching Stripe's own price
// representation) rather than Decimal, specifically so the eventual Stripe
// sync never has to translate between two different money representations.
// Deliberately separate from SoftwarePlan/IndustryDataPackage (STRIPE-1A's
// audit found those built for an earlier dev-only-activation phase, USD-
// denominated, with none of the approved AED product codes) rather than
// repurposing them — this catalogue can be seeded and inspected today with
// zero risk to the existing trial/subscription paths those models serve.

enum CommerceProductType {
  SUBSCRIPTION
  ONE_TIME
  INDUSTRY_ACCESS
  AI_CREDIT_PACK
  ADD_ON
  ENTERPRISE
}

/// How a customer is expected to acquire this product. DIRECT is the only
/// mode any future checkout phase may treat as "add to cart and pay" — every
/// other mode must route to a human process (contact-sales / quotation),
/// never a live price the customer can self-checkout with.
enum CommercePurchaseMode {
  DIRECT
  QUOTATION_REQUIRED
  CONTACT_SALES
}

enum CommerceBillingInterval {
  ONE_TIME
  MONTH
  YEAR
}

/// A controlled enum, not a free string, specifically to prevent the
/// currency-inconsistency STRIPE-1A found across SoftwarePlan/IndustryData-
/// Package (USD by default) vs Project/RateCatalogueItem (AED by default).
/// AED is the only launch currency; extend this enum, never widen it to a
/// free string, when a second currency is genuinely needed.
enum CommerceCurrency {
  AED
}

model CommerceProduct {
  id                  String                    @id @default(uuid()) @db.Uuid
  code                String                    @unique
  type                CommerceProductType
  name                String
  shortDescription    String                    @default("")
  description         String                    @default("")
  purchaseMode        CommercePurchaseMode      @default(DIRECT)
  isActive            Boolean                   @default(true)
  isPublic            Boolean                   @default(true)
  sortOrder           Int                       @default(0)
  /// Set only for type: INDUSTRY_ACCESS, and only when a real backing
  /// IndustryDataPackage exists — never set on a product for a dataset that
  /// doesn't exist yet (the seed script enforces this; see its "skipped"
  /// count for industries with no backing package).
  industryPackageId   String?                   @db.Uuid
  metadataJson        Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  industryPackage     IndustryDataPackage?      @relation(fields: [industryPackageId], references: [id], onDelete: SetNull)
  prices              CommercePrice[]
  entitlementTemplate EntitlementTemplate?
  providerMappings    CommerceProviderMapping[]

  @@index([type])
  @@index([isActive])
  @@index([isPublic])
  @@index([industryPackageId])
}

/// Prices are treated as append-only once a product has ever been used
/// commercially (no later phase in this codebase may destructively edit a
/// price's amount/currency/interval after the fact) — a price change is
/// always a new CommercePrice row with a new code, with the old row's
/// isActive flipped to false, never an in-place mutation. Nothing enforces
/// that immutability at the database level in this phase (no purchase can
/// reference a price yet), but the service layer's update path already
/// follows this rule so later phases inherit safe behavior by default.
model CommercePrice {
  id               String                    @id @default(uuid()) @db.Uuid
  productId        String                    @db.Uuid
  code             String                    @unique
  /// Integer minor units — e.g. AED 149.00 is stored as 14900. Never Float.
  amountMinor      Int
  currency         CommerceCurrency          @default(AED)
  billingInterval  CommerceBillingInterval
  /// True when amountMinor is an indicative "starting from" price rather
  /// than an exact purchasable amount (e.g. api_access_monthly_from_aed_499,
  /// white_label_from_aed_5000) — the UI must render "from AED X" and must
  /// never present this as a fixed-price direct-checkout amount.
  isFromPrice      Boolean                   @default(false)
  isActive         Boolean                   @default(true)
  validFrom        DateTime                  @default(now())
  validUntil       DateTime?
  /// STRIPE-1C — commercial review gate. Defaults to REQUIRES_REVIEW for
  /// every price, including ones that already existed before this column
  /// was added — never silently APPROVED. Only a small, explicitly
  /// identified set of anchor prices (matching an independently confirmed
  /// commercial source) are promoted to APPROVED, and only via a one-time,
  /// reviewed data step — never as a migration column default.
  reviewStatus     CommercePriceReviewStatus @default(REQUIRES_REVIEW)
  reviewedByUserId String?                   @db.Uuid
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  product          CommerceProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewedByUser   User?                     @relation("CommercePriceReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  providerMappings CommerceProviderMapping[]

  @@index([productId])
  @@index([isActive])
  @@index([billingInterval])
  @@index([reviewStatus])
}

/// STRIPE-1C — commercial review gate for a CommercePrice. A price may only
/// synchronize to Stripe as an active, purchasable Price once APPROVED.
enum CommercePriceReviewStatus {
  DRAFT
  REQUIRES_REVIEW
  APPROVED
  RETIRED
}

/// The typed commercial grant a product confers. One row per product — kept
/// 1:1 rather than versioned in this phase (no purchase can consume one yet,
/// so there is nothing to keep historically pinned to an old version). Every
/// field here is a real, named column rather than JSON specifically so a
/// later enforcement pass can query/validate against it directly; metadataJson
/// exists only for genuinely exceptional future fields, never as a substitute
/// for a real column.
model EntitlementTemplate {
  id                              String          @id @default(uuid()) @db.Uuid
  productId                       String          @unique @db.Uuid
  maxUsers                        Int?
  maxWorkspaces                   Int?
  maxActiveProjects               Int?
  maxBoqGenerationsPerMonth       Int?
  maxTechnicalReportsPerMonth     Int?
  maxWatermarkFreeExportsPerMonth Int?
  /// JSON string array, e.g. ["PDF", "DOCX"] — matches this codebase's
  /// existing convention of *Json fields for list-shaped data (see
  /// MasterItem.defaultTagsJson/searchKeywordsJson) rather than a native
  /// Postgres array, for consistency.
  permittedExportFormatsJson      Json?
  removesWatermark                Boolean         @default(false)
  allowsCompanyBranding           Boolean         @default(false)
  /// STRIPE-1A found assertFeatureAccess("api-access") already exists but is
  /// dead code with zero call sites — this field records the *commercial
  /// grant*, not enforcement; the admin UI must say so truthfully (a static
  /// per-field enforcement-status map lives in entitlement-template-service.ts,
  /// not the schema, since it's a fact about the app's current code, not data).
  allowsApiAccess                 Boolean         @default(false)
  allowsWhiteLabel                Boolean         @default(false)
  /// JSON string array of IndustryDataPackage.key values this product
  /// grants access to — deliberately separate from CommerceProduct's own
  /// single industryPackageId, since an ADD_ON or SUBSCRIPTION product's
  /// entitlement template can grant more than one package.
  industryPackageKeysJson         Json?
  aiCreditsGranted                Int?
  downloadLimit                   Int?
  entitlementDurationDays         Int?
  metadataJson                    Json?
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt
  product                         CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SalesInquiry {
  id                      String   @id @default(uuid()) @db.Uuid
  firstName               String
  lastName                String
  workEmail               String
  companySize             String
  useCase                 String
  companyType             String?
  constructionDiscipline  String?
  currentBoqProcess       String?
  monthlyVolume           String?
  requiredInputs          String?
  requiredOutputs         String?
  numberOfUsers           String?
  integrationRequirements String?
  preferredContactMethod  String?
  consent                 Boolean?
  deliveryStatus          String   @default("stored")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// STRIPE-1C — Stripe test-mode product/price synchronization
// ---------------------------------------------------------------------------
// Quantara's CommerceProduct/CommercePrice remain the sole source of truth for
// amount, currency, interval, and commercial approval — these two models only
// record which payment-provider objects a given internal record has been
// synchronized to, and a history of synchronization runs. No payment
// collection, checkout, customer, subscription, order, invoice, or webhook
// concept is introduced here. Deliberately provider-agnostic (CommerceProvider
// is an enum with one member today) so a second provider never requires a
// schema redesign.

enum CommerceProvider {
  STRIPE
}

enum CommerceProviderEnvironment {
  TEST
  LIVE
}

enum CommerceProviderObjectType {
  PRODUCT
  PRICE
}

/// Per-mapping sync health, independent of CommerceSyncRun history — this is
/// "what is true right now for this one object", not a log entry.
enum CommerceProviderSyncStatus {
  SYNCED
  DRIFTED
  ARCHIVED
  ERROR
}

/// Records that a specific internal CommerceProduct or CommercePrice has been
/// synchronized to a specific provider object. One row per internal object per
/// provider per environment — never a full copy of the provider's response
/// (see providerActive/lastErrorCode below; nothing sensitive or bulky is
/// stored here). True uniqueness (no duplicate mapping for the same internal
/// product/price, and no duplicate mapping for the same provider object) is
/// enforced via partial unique indexes in the migration — Postgres allows
/// multiple NULLs through a plain unique index, which is wrong here since
/// commercePriceId/providerPriceId are only meaningful for PRICE-type rows.
model CommerceProviderMapping {
  id                    String                      @id @default(uuid()) @db.Uuid
  provider              CommerceProvider
  environment           CommerceProviderEnvironment
  commerceProductId     String                      @db.Uuid
  /// Null for a PRODUCT-type mapping row; set for a PRICE-type row.
  commercePriceId       String?                     @db.Uuid
  providerProductId     String
  /// Null for a PRODUCT-type mapping row; set for a PRICE-type row.
  providerPriceId       String?
  providerObjectType    CommerceProviderObjectType
  providerActive        Boolean                     @default(true)
  synchronizationStatus CommerceProviderSyncStatus  @default(SYNCED)
  lastSynchronizedAt    DateTime?
  lastVerifiedAt        DateTime?
  lastErrorCode         String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  commerceProduct       CommerceProduct             @relation(fields: [commerceProductId], references: [id], onDelete: Cascade)
  commercePrice         CommercePrice?              @relation(fields: [commercePriceId], references: [id], onDelete: Cascade)

  @@index([commerceProductId])
  @@index([commercePriceId])
  @@index([provider, environment])
  @@index([synchronizationStatus])
}

enum CommerceSyncOperation {
  DRY_RUN
  SYNCHRONIZE
  VERIFY
}

enum CommerceSyncRunStatus {
  PLANNED
  RUNNING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  CANCELLED
}

/// One row per synchronization attempt (dry run, execution, or verification
/// pass) — an audit-friendly summary only. Never stores raw Stripe request/
/// response bodies; only safe aggregate counts and a safe error code.
model CommerceSyncRun {
  id                   String                      @id @default(uuid()) @db.Uuid
  provider             CommerceProvider
  environment          CommerceProviderEnvironment
  operation            CommerceSyncOperation
  status               CommerceSyncRunStatus       @default(PLANNED)
  initiatedByUserId    String?                     @db.Uuid
  dryRun               Boolean
  /// Hash of the eligible catalogue slice at plan time — execution is
  /// rejected if the live catalogue no longer matches this fingerprint,
  /// forcing a fresh dry run instead of acting on a stale plan.
  catalogueFingerprint String
  productsCreated      Int                         @default(0)
  productsUpdated      Int                         @default(0)
  productsUnchanged    Int                         @default(0)
  productsArchived     Int                         @default(0)
  pricesCreated        Int                         @default(0)
  pricesUnchanged      Int                         @default(0)
  pricesArchived       Int                         @default(0)
  blockedCount         Int                         @default(0)
  warningCount         Int                         @default(0)
  safeErrorCode        String?
  startedAt            DateTime                    @default(now())
  completedAt          DateTime?
  initiatedByUser      User?                       @relation("CommerceSyncRunInitiator", fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([provider, environment])
  @@index([status])
  @@index([startedAt])
}
