model TrialPremiumItemUnlock {
  id              String                      @id @default(uuid()) @db.Uuid
  companyId       String                      @db.Uuid
  subscriptionId  String                      @db.Uuid
  masterItemId    String                      @db.Uuid
  firstUnlockedAt DateTime                    @default(now())
  lastUsedAt      DateTime                    @default(now())
  usageCount      Int                         @default(1)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription    CompanySoftwareSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  masterItem      MasterItem                  @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  @@unique([companyId, subscriptionId, masterItemId])
  @@index([companyId])
  @@index([subscriptionId])
  @@index([masterItemId])
}

enum SimulationMode {
  TRIAL_ACTIVE
  TRIAL_EXPIRED
  FREE
  PRO
  SINGLE_BOQ_UNLOCKED
}

/**
 * A platform owner's ephemeral "customer simulation" context (ADMIN-CONTROL-1
 * section 3). One row per user, upserted in place — never versioned history,
 * never a real subscription. Reading this and reflecting it back in
 * getEffectiveEntitlements() is the *only* thing that changes owner-visible
 * entitlement behavior during simulation; no CompanySoftwareSubscription row
 * is ever touched by starting, changing, or exiting a simulation.
 */
model PlatformSimulationSession {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @unique @db.Uuid
  mode        SimulationMode
  targetBoqId String?        @db.Uuid
  startedAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MasterCatalogueImportStatus {
  DRY_RUN
  EXECUTED
  ROLLED_BACK
}

/**
 * A platform-owner-only bulk import batch into the tenant-less
 * MasterItem/MasterDiscipline catalogue (ADMIN-CONTROL-1 section 5) —
 * deliberately separate from ImportJob/ImportRow, which are company-scoped
 * and belong to a different tenancy model entirely. Row-level detail is
 * kept as a bounded JSON report rather than a separate row table, since
 * this is an administrative/audit view, not a reviewable per-row workflow
 * like the company import feature.
 */
model MasterCatalogueImportBatch {
  id                   String                      @id @default(uuid()) @db.Uuid
  actorUserId          String                      @db.Uuid
  disciplineId         String                      @db.Uuid
  uploadedFileName     String
  checksum             String
  status               MasterCatalogueImportStatus @default(DRY_RUN)
  totalRows            Int                         @default(0)
  insertedCount        Int                         @default(0)
  updatedCount         Int                         @default(0)
  unchangedCount       Int                         @default(0)
  rejectedCount        Int                         @default(0)
  validationReportJson Json?
  executedAt           DateTime?
  rolledBackAt         DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  actor                User                        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  discipline           MasterDiscipline            @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  createdItems         MasterItem[]
  importJobs           MasterCatalogueImportJob[]

  @@index([actorUserId])
  @@index([disciplineId])
  @@index([status])
  @@index([checksum])
}

/// CATALOGUE-PROD-ACTIVATE — workflow state of one registered-dataset
/// production activation. Mirrors the task's required state machine exactly
/// so a stalled/interrupted job's state is always self-explanatory from the
/// row alone, without needing to read application code to know what a given
/// status means.
enum MasterCatalogueImportJobStatus {
  REGISTERED
  VALIDATING
  DRY_RUN_RUNNING
  DRY_RUN_COMPLETE
  AWAITING_CONFIRMATION
  IMPORT_RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  CANCELLED
  ROLLED_BACK
}

/// CATALOGUE-PROD-ACTIVATE — a resumable, checkpointed activation of one
/// registered dataset (see catalogue-dataset-registry.ts), replacing the
/// fragile "hold one browser request open for the whole file" execution
/// model MasterCatalogueImportBatch was built for. One row per dataset
/// activation attempt (not per file) — currentRowCursor is a single
/// logical offset into the dataset's ordered file list, so resuming after
/// an interruption never needs to know which physical file it was mid-way
/// through; the engine re-derives that from the cursor and the registry's
/// own file manifest.
model MasterCatalogueImportJob {
  id                     String                         @id @default(uuid()) @db.Uuid
  datasetId              String
  datasetVersion         String
  actorUserId            String                         @db.Uuid
  disciplineId           String                         @db.Uuid
  /// Companion MasterCatalogueImportBatch row created when execution starts,
  /// purely so MasterItem.sourceBatchId (and the existing admin batch-history
  /// view) stays meaningful for items imported through this resumable path —
  /// without adding a second, parallel provenance FK on MasterItem itself.
  legacyBatchId          String?                        @db.Uuid
  status                 MasterCatalogueImportJobStatus @default(REGISTERED)
  /// Combined sha256 of every registered source file's own checksum, joined
  /// in manifest order — changes if the registry's file list, order, or any
  /// single file's content changes, which is exactly the signal used to
  /// reject an execution whose dry run no longer matches its source.
  sourceChecksum         String
  manifestJson           Json
  dryRunReportJson       Json?
  batchSize              Int                            @default(200)
  currentRowCursor       Int                            @default(0)
  totalRows              Int                            @default(0)
  processedRows          Int                            @default(0)
  insertedCount          Int                            @default(0)
  updatedCount           Int                            @default(0)
  unchangedCount         Int                            @default(0)
  rejectedCount          Int                            @default(0)
  warningCount           Int                            @default(0)
  itemsCreated           Int                            @default(0)
  versionsCreated        Int                            @default(0)
  classificationsCreated Int                            @default(0)
  hierarchyNodesCreated  Int                            @default(0)
  categoriesCreated      Int                            @default(0)
  currentFileName        String?
  lastErrorMessage       String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  actor                  User                           @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  discipline             MasterDiscipline               @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  legacyBatch            MasterCatalogueImportBatch?    @relation(fields: [legacyBatchId], references: [id], onDelete: SetNull)

  @@index([datasetId])
  @@index([status])
  @@index([actorUserId])
  @@index([datasetId, status])
}

