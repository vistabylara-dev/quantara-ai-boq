// ---------- Phase 7: commercial access, entitlements, master data platform ----------

enum PlanType {
  FREE
  TRIAL
  PRO
  BUSINESS
  ENTERPRISE
}

/**
 * Shared by both CompanySoftwareSubscription and CompanyPackageSubscription — identical lifecycle.
 */
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum TechnicalFieldType {
  TEXT
  NUMBER
  DECIMAL
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
  DIMENSION
  RANGE
  JSON
}

enum MasterItemStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

/// MASTER-BOQ-1A — arbitrary-depth classification tree (Industry -> Discipline
/// -> System -> Category -> Subcategory -> Item Family). A single
/// self-referential node model is used instead of one table per level so the
/// hierarchy can grow (new industries/disciplines) without further migrations.
enum MasterHierarchyNodeType {
  INDUSTRY
  DISCIPLINE
  SYSTEM
  CATEGORY
  SUBCATEGORY
  ITEM_FAMILY
}

/// Workflow state of one MasterItemVersion — separate from MasterItem.status
/// (which is the item's overall lifecycle: DRAFT/ACTIVE/DEPRECATED/ARCHIVED).
enum MasterItemVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

enum MasterClassificationSystem {
  MASTERFORMAT_2020
  CSI
  OMNICLASS
  UNIFORMAT
  IFC
  INTERNAL_QUANTARA
  REVIT_CATEGORY
  CAD_LAYER
  REGIONAL_CODE
  COST_CODE
}

enum MasterRegionScope {
  UAE
  GCC
  INTERNATIONAL
  COUNTRY_SPECIFIC
}

enum MasterQuantityMethod {
  COUNT
  LENGTH
  AREA
  VOLUME
  WEIGHT
}

enum MasterAttributeVerificationState {
  UNVERIFIED
  VERIFIED
  NEEDS_REVIEW
}

/// Deliberately small and not yet populated for any item — the contract for
/// future assemblies/methodology (accessories, materials, labor, testing,
/// commissioning, substitution) without building those engines yet.
enum MasterItemRelationType {
  REQUIRED_ACCESSORY
  OPTIONAL_ACCESSORY
  MATERIAL
  LABOR
  EQUIPMENT
  CONSUMABLE
  TESTED_WITH
  COMMISSIONED_WITH
  INSTALLED_WITH
  ALTERNATIVE_TO
  REPLACEMENT
  PART_OF_ASSEMBLY
}

enum IndustryPackageType {
  CORE
  PROFESSIONAL
  SPECIALIST
  ENTERPRISE
  REGIONAL
}

enum IndustryPackageStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum CompanyLibrarySourceType {
  MASTER_PACKAGE
  MANUAL
  IMPORTED
  PREVIOUS_PROJECT
  SUPPLIER_CATALOGUE
}

enum BoqItemSourceType {
  MANUAL
  MASTER_ITEM
  COMPANY_LIBRARY
  RATE_CATALOGUE
  PREVIOUS_BOQ
  IMPORT
}

enum ImportSourceType {
  CSV
  XLSX
}

enum ImportDestinationType {
  COMPANY_LIBRARY
  RATE_CATALOGUE
  DRAFT_BOQ
  STAGING_REVIEW
}

enum ImportJobStatus {
  PENDING
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  VALID
  WARNING
  ERROR
  APPROVED
  IMPORTED
  REJECTED
}

model SoftwarePlan {
  id                   String                        @id @default(uuid()) @db.Uuid
  key                  String                        @unique
  name                 String
  description          String                        @default("")
  planType             PlanType
  monthlyPrice         Decimal                       @default(0) @db.Decimal(12, 2)
  annualPrice          Decimal                       @default(0) @db.Decimal(12, 2)
  currency             String                        @default("USD")
  maxUsers             Int?
  maxProjects          Int?
  maxActiveBoqs        Int?
  maxDocumentsPerMonth Int?
  maxStorageBytes      BigInt?
  featuresJson         Json?
  isActive             Boolean                       @default(true)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  subscriptions        CompanySoftwareSubscription[]

  @@index([planType])
  @@index([isActive])
}

model CompanySoftwareSubscription {
  id                     String                   @id @default(uuid()) @db.Uuid
  companyId              String                   @db.Uuid
  softwarePlanId         String                   @db.Uuid
  status                 SubscriptionStatus
  trialStartedAt         DateTime?
  trialExpiresAt         DateTime?
  startsAt               DateTime?
  expiresAt              DateTime?
  cancelledAt            DateTime?
  externalSubscriptionId String?
  source                 String                   @default("development")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  softwarePlan           SoftwarePlan             @relation(fields: [softwarePlanId], references: [id], onDelete: Restrict)
  trialUsage             CompanyTrialUsage[]
  trialPremiumUnlocks    TrialPremiumItemUnlock[]

  @@index([companyId])
  @@index([softwarePlanId])
  @@index([status])
}

model CompanyTrialUsage {
  id                         String                      @id @default(uuid()) @db.Uuid
  companyId                  String                      @db.Uuid
  subscriptionId             String                      @db.Uuid
  projectsCreated            Int                         @default(0)
  boqsCompleted              Int                         @default(0)
  documentsGenerated         Int                         @default(0)
  proposalsCreated           Int                         @default(0)
  uniquePremiumItemsUnlocked Int                         @default(0)
  firstUsedAt                DateTime?
  lastUsedAt                 DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription               CompanySoftwareSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([companyId, subscriptionId])
  @@index([companyId])
  @@index([subscriptionId])
}

model TrialPremiumItemUnlock {
  id              String                      @id @default(uuid()) @db.Uuid
  companyId       String                      @db.Uuid
  subscriptionId  String                      @db.Uuid
  masterItemId    String                      @db.Uuid
  firstUnlockedAt DateTime                    @default(now())
  lastUsedAt      DateTime                    @default(now())
  usageCount      Int                         @default(1)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription    CompanySoftwareSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  masterItem      MasterItem                  @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  @@unique([companyId, subscriptionId, masterItemId])
  @@index([companyId])
  @@index([subscriptionId])
  @@index([masterItemId])
}

enum SimulationMode {
  TRIAL_ACTIVE
  TRIAL_EXPIRED
  FREE
  PRO
  SINGLE_BOQ_UNLOCKED
}

/**
 * A platform owner's ephemeral "customer simulation" context (ADMIN-CONTROL-1
 * section 3). One row per user, upserted in place — never versioned history,
 * never a real subscription. Reading this and reflecting it back in
 * getEffectiveEntitlements() is the *only* thing that changes owner-visible
 * entitlement behavior during simulation; no CompanySoftwareSubscription row
 * is ever touched by starting, changing, or exiting a simulation.
 */
model PlatformSimulationSession {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @unique @db.Uuid
  mode        SimulationMode
  targetBoqId String?        @db.Uuid
  startedAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MasterCatalogueImportStatus {
  DRY_RUN
  EXECUTED
  ROLLED_BACK
}

/**
 * A platform-owner-only bulk import batch into the tenant-less
 * MasterItem/MasterDiscipline catalogue (ADMIN-CONTROL-1 section 5) —
 * deliberately separate from ImportJob/ImportRow, which are company-scoped
 * and belong to a different tenancy model entirely. Row-level detail is
 * kept as a bounded JSON report rather than a separate row table, since
 * this is an administrative/audit view, not a reviewable per-row workflow
 * like the company import feature.
 */
model MasterCatalogueImportBatch {
  id                   String                      @id @default(uuid()) @db.Uuid
  actorUserId          String                      @db.Uuid
  disciplineId         String                      @db.Uuid
  uploadedFileName     String
  checksum             String
  status               MasterCatalogueImportStatus @default(DRY_RUN)
  totalRows            Int                         @default(0)
  insertedCount        Int                         @default(0)
  updatedCount         Int                         @default(0)
  unchangedCount       Int                         @default(0)
  rejectedCount        Int                         @default(0)
  validationReportJson Json?
  executedAt           DateTime?
  rolledBackAt         DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  actor                User                        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  discipline           MasterDiscipline            @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  createdItems         MasterItem[]

  @@index([actorUserId])
  @@index([disciplineId])
  @@index([status])
  @@index([checksum])
}

model CompanyBranding {
  id                  String            @id @default(uuid()) @db.Uuid
  companyId           String            @unique @db.Uuid
  primaryColor        String            @default("#0F172A")
  secondaryColor      String            @default("#1E293B")
  accentColor         String            @default("#2563EB")
  documentHeaderColor String            @default("#0F172A")
  tableHeaderColor    String            @default("#1E293B")
  coverStyle          String            @default("light")
  logoPosition        String            @default("top-left")
  preferredTemplateId String?           @db.Uuid
  emailSignatureHtml  String            @default("")
  footerText          String            @default("")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  preferredTemplate   DocumentTemplate? @relation(fields: [preferredTemplateId], references: [id], onDelete: SetNull)

  @@index([preferredTemplateId])
}

model MasterDiscipline {
  id                           String                       @id @default(uuid()) @db.Uuid
  key                          String                       @unique
  name                         String
  description                  String                       @default("")
  icon                         String?
  sortOrder                    Int                          @default(0)
  isActive                     Boolean                      @default(true)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  categories                   MasterCategory[]
  items                        MasterItem[]
  fieldDefinitions             TechnicalFieldDefinition[]
  packages                     IndustryDataPackage[]
  libraryItems                 CompanyLibraryItem[]
  symbolDefinitions            SymbolDefinition[]
  masterCatalogueImportBatches MasterCatalogueImportBatch[]

  @@index([isActive])
}

model MasterCategory {
  id               String                     @id @default(uuid()) @db.Uuid
  disciplineId     String                     @db.Uuid
  parentCategoryId String?                    @db.Uuid
  key              String
  name             String
  description      String                     @default("")
  path             String
  depth            Int                        @default(0)
  sortOrder        Int                        @default(0)
  isActive         Boolean                    @default(true)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  discipline       MasterDiscipline           @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  parentCategory   MasterCategory?            @relation("CategoryParent", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories  MasterCategory[]           @relation("CategoryParent")
  items            MasterItem[]
  fieldDefinitions TechnicalFieldDefinition[]
  libraryItems     CompanyLibraryItem[]

  @@index([disciplineId])
  @@index([parentCategoryId])
  @@index([path])
}

model MasterItem {
  id                         String                            @id @default(uuid()) @db.Uuid
  disciplineId               String                            @db.Uuid
  categoryId                 String                            @db.Uuid
  itemCode                   String
  name                       String
  shortDescription           String                            @default("")
  fullDescription            String                            @default("")
  defaultUnit                String
  defaultSpecificationJson   Json?
  technicalFieldsJson        Json?
  defaultTagsJson            Json?
  searchKeywordsJson         Json?
  synonymsJson               Json?
  defaultManufacturerType    String?
  defaultInstallationMethod  String?
  defaultTestingRequirement  String?
  defaultWarrantyRequirement String?
  defaultDocumentLabelsJson  Json?
  version                    Int                               @default(1)
  status                     MasterItemStatus                  @default(ACTIVE)
  isPremium                  Boolean                           @default(true)
  sourceBatchId              String?                           @db.Uuid
  /// MASTER-BOQ-1A — deepest known node in the new deep hierarchy (usually
  /// Item Family, but Subcategory or Category if a family hasn't been
  /// defined yet, e.g. for the existing HVAC data). Nullable and additive:
  /// existing rows keep working through disciplineId/categoryId unchanged.
  hierarchyNodeId            String?                           @db.Uuid
  replacementItemId          String?                           @db.Uuid
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
  discipline                 MasterDiscipline                  @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  category                   MasterCategory                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sourceBatch                MasterCatalogueImportBatch?       @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)
  hierarchyNode              MasterHierarchyNode?              @relation(fields: [hierarchyNodeId], references: [id], onDelete: SetNull)
  replacementItem            MasterItem?                       @relation("MasterItemReplacement", fields: [replacementItemId], references: [id], onDelete: SetNull)
  replacedByItems            MasterItem[]                      @relation("MasterItemReplacement")
  packageItems               IndustryDataPackageItem[]
  trialUnlocks               TrialPremiumItemUnlock[]
  libraryItems               CompanyLibraryItem[]
  boqItems                   BOQItem[]
  versions                   MasterItemVersion[]
  variants                   MasterItemVariant[]
  classifications            MasterItemClassification[]
  regionalApplicability      MasterItemRegionalApplicability[]
  drawingProfile             MasterItemDrawingProfile?
  attributeValues            MasterItemAttributeValue[]
  relationsFrom              MasterItemRelation[]              @relation("MasterItemRelationFrom")
  relationsTo                MasterItemRelation[]              @relation("MasterItemRelationTo")

  @@unique([disciplineId, itemCode])
  @@index([disciplineId])
  @@index([categoryId])
  @@index([status])
  @@index([isPremium])
  @@index([name])
  @@index([sourceBatchId])
  @@index([hierarchyNodeId])
  @@index([replacementItemId])
}

/// MASTER-BOQ-1A reuses this existing model as the "Attribute Definition"
/// half of the definition+value pattern (it already had code/label/type/
/// unit/options/validation/required/searchable/filterable/order) rather than
/// building a duplicate table. isActive, unitFamily, allowedUnitsJson, and
/// applicableHierarchyNodeId are additive columns for the new requirements;
/// MasterItemAttributeValue below is the new "Attribute Value" half.
model TechnicalFieldDefinition {
  id                        String                     @id @default(uuid()) @db.Uuid
  disciplineId              String                     @db.Uuid
  categoryId                String?                    @db.Uuid
  key                       String
  label                     String
  description               String                     @default("")
  fieldType                 TechnicalFieldType
  unit                      String?
  unitFamily                String?
  allowedUnitsJson          Json?
  optionsJson               Json?
  validationJson            Json?
  isRequired                Boolean                    @default(false)
  isSearchable              Boolean                    @default(false)
  isFilterable              Boolean                    @default(false)
  isActive                  Boolean                    @default(true)
  applicableHierarchyNodeId String?                    @db.Uuid
  sortOrder                 Int                        @default(0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  discipline                MasterDiscipline           @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  category                  MasterCategory?            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  applicableHierarchyNode   MasterHierarchyNode?       @relation(fields: [applicableHierarchyNodeId], references: [id], onDelete: SetNull)
  attributeValues           MasterItemAttributeValue[]

  @@index([disciplineId])
  @@index([applicableHierarchyNodeId])
  @@index([categoryId])
}

/// MASTER-BOQ-1A — generic self-referential classification tree node.
/// Industry -> Discipline -> System -> Category -> Subcategory -> Item Family
/// all live here as MasterHierarchyNodeType-tagged rows instead of one table
/// per level, so a new industry/discipline never needs a migration. Cycle
/// prevention is enforced in master-hierarchy-service.ts (not expressible as
/// a Postgres constraint on a self-referential adjacency list).
model MasterHierarchyNode {
  id               String                     @id @default(uuid()) @db.Uuid
  code             String                     @unique
  name             String
  description      String                     @default("")
  nodeType         MasterHierarchyNodeType
  parentId         String?                    @db.Uuid
  regionScope      MasterRegionScope?
  isActive         Boolean                    @default(true)
  sortOrder        Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  parent           MasterHierarchyNode?       @relation("MasterHierarchyParent", fields: [parentId], references: [id], onDelete: Restrict)
  children         MasterHierarchyNode[]      @relation("MasterHierarchyParent")
  items            MasterItem[]
  fieldDefinitions TechnicalFieldDefinition[]

  @@index([parentId])
  @@index([nodeType])
  @@index([isActive])
}

/// Published master items are never destructively overwritten — a BOQ line
/// snapshots the exact version it used (see BOQItem.sourceMasterItemVersionId
/// below), and later edits to the master item never retroactively change a
/// locked historical BOQ.
model MasterItemVersion {
  id                    String                     @id @default(uuid()) @db.Uuid
  masterItemId          String                     @db.Uuid
  versionNumber         Int
  status                MasterItemVersionStatus    @default(DRAFT)
  effectiveDate         DateTime?
  supersededDate        DateTime?
  changeSummary         String                     @default("")
  name                  String
  shortDescription      String                     @default("")
  fullDescription       String                     @default("")
  specificationTemplate String                     @default("")
  inclusionTemplate     String                     @default("")
  exclusionTemplate     String                     @default("")
  notesTemplate         String                     @default("")
  primaryUnit           String
  measurementMethod     String                     @default("")
  quantityBasis         String                     @default("")
  roundingRule          String                     @default("")
  wasteFactorPercentage Decimal?                   @db.Decimal(7, 4)
  packageMultiple       Decimal?                   @db.Decimal(12, 4)
  createdByUserId       String?                    @db.Uuid
  reviewedByUserId      String?                    @db.Uuid
  approvedByUserId      String?                    @db.Uuid
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  masterItem            MasterItem                 @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
  createdByUser         User?                      @relation("MasterItemVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedByUser        User?                      @relation("MasterItemVersionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedByUser        User?                      @relation("MasterItemVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  attributeValues       MasterItemAttributeValue[]
  boqItems              BOQItem[]

  @@unique([masterItemId, versionNumber])
  @@index([masterItemId])
  @@index([status])
}

/// The leaf level below Master Item in the hierarchy example ("10,000 CFM
/// Chilled-Water Double-Skin Variant"). Kept minimal — identity + status
/// only — since assemblies/full variant configuration are out of scope for
/// this phase.
model MasterItemVariant {
  id              String                     @id @default(uuid()) @db.Uuid
  masterItemId    String                     @db.Uuid
  code            String
  name            String
  description     String                     @default("")
  isActive        Boolean                    @default(true)
  sortOrder       Int                        @default(0)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  masterItem      MasterItem                 @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
  attributeValues MasterItemAttributeValue[]

  @@unique([masterItemId, code])
  @@index([masterItemId])
}

/// The "Attribute Value" half of the definition+value pattern (definitions
/// live on the existing TechnicalFieldDefinition model above). Typed columns
/// rather than a single JSON blob so searchable/filterable values stay
/// queryable. Exactly one of masterItemId/variantId is expected to be set —
/// enforced in master-attribute-service.ts, not at the DB level.
model MasterItemAttributeValue {
  id                  String                           @id @default(uuid()) @db.Uuid
  masterItemId        String?                          @db.Uuid
  variantId           String?                          @db.Uuid
  fieldDefinitionId   String                           @db.Uuid
  valueText           String?
  valueNumber         Decimal?                         @db.Decimal(20, 6)
  valueBoolean        Boolean?
  valueDate           DateTime?
  unit                String?
  source              String                           @default("")
  verificationState   MasterAttributeVerificationState @default(UNVERIFIED)
  masterItemVersionId String?                          @db.Uuid
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  masterItem          MasterItem?                      @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
  variant             MasterItemVariant?               @relation(fields: [variantId], references: [id], onDelete: Cascade)
  fieldDefinition     TechnicalFieldDefinition         @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  masterItemVersion   MasterItemVersion?               @relation(fields: [masterItemVersionId], references: [id], onDelete: SetNull)

  @@index([masterItemId])
  @@index([variantId])
  @@index([fieldDefinitionId])
}

/// A mapping model (rather than fixed MasterFormat/OmniClass/... columns on
/// MasterItem) since not every item has every classification, and new
/// classification systems can be added without a migration.
model MasterItemClassification {
  id           String                     @id @default(uuid()) @db.Uuid
  masterItemId String                     @db.Uuid
  system       MasterClassificationSystem
  code         String
  label        String                     @default("")
  version      String                     @default("")
  isPrimary    Boolean                    @default(false)
  source       String                     @default("")
  isVerified   Boolean                    @default(false)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  masterItem   MasterItem                 @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  @@unique([masterItemId, system, code])
  @@index([masterItemId])
  @@index([system])
}

model MasterItemRegionalApplicability {
  id                       String            @id @default(uuid()) @db.Uuid
  masterItemId             String            @db.Uuid
  scope                    MasterRegionScope
  /// Empty string (not null) for scope-only rows (UAE/GCC/INTERNATIONAL) so
  /// the compound unique constraint below has a well-defined value —
  /// Prisma's generated compound-unique lookup type does not accept null.
  countryCode              String            @default("")
  effectiveFrom            DateTime?
  effectiveTo              DateTime?
  languageAvailabilityJson Json?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  masterItem               MasterItem        @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  @@unique([masterItemId, scope, countryCode])
  @@index([masterItemId])
}

/// The clean data contract for future drawing/BIM matching — not the
/// matching logic itself. One profile per item.
model MasterItemDrawingProfile {
  id                 String                @id @default(uuid()) @db.Uuid
  masterItemId       String                @unique @db.Uuid
  drawingTypesJson   Json?
  scheduleTypesJson  Json?
  symbolReference    String?
  cadLayerReference  String?
  ifcClass           String?
  revitCategory      String?
  roomSpaceTypesJson Json?
  quantityMethod     MasterQuantityMethod?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
