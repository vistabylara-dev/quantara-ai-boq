generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  NEEDS_REVIEW
  INTERNALLY_APPROVED
  SENT
  CLIENT_APPROVED
  REVISION_REQUESTED
  REJECTED
  ARCHIVED
}

enum BOQStatus {
  DRAFT
  CALCULATED
  NEEDS_VERIFICATION
  LOCKED
  ISSUED
  APPROVED
}

enum BOQItemStatus {
  DRAFT
  EXTRACTED
  NEEDS_REVIEW
  CONFIRMED
  CORRECTED
  REJECTED
  LOCKED
}

enum MarginMode {
  MARKUP
  GROSS_MARGIN
}

enum VerificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum RateStatus {
  ACTIVE
  PENDING
  EXPIRED
  INACTIVE
}

enum UserRole {
  COMPANY_OWNER
  ADMINISTRATOR
  QUANTITY_SURVEYOR
  ESTIMATOR
  DESIGNER
  SALES_USER
  REVIEWER
}

enum DocumentTemplateType {
  CORPORATE_TECHNICAL
  EXECUTIVE_PREMIUM
  FURNITURE_CATALOGUE
  MEP_TENDER
  ARABIC_FORMAL
}

enum GeneratedDocumentType {
  CSV
  XLSX
  PDF
  DOCX
  HTML
}

enum GeneratedDocumentStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
}

enum DocumentAudience {
  INTERNAL
  CLIENT
}

model Company {
  id                          String                      @id @default(uuid()) @db.Uuid
  legalName                   String
  tradeName                   String
  email                       String
  phone                       String?
  website                     String?
  address                     String?
  taxRegistrationNumber       String?
  defaultCurrency             String                      @default("AED")
  vatRate                     Decimal                     @default(5) @db.Decimal(7, 4)
  defaultLanguage             String                      @default("English")
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  industryEngines             CompanyIndustryEngine[]
  clients                     Client[]
  projects                    Project[]
  boqs                        BOQ[]
  boqSections                 BOQSection[]
  boqItems                    BOQItem[]
  boqItemOptions              BOQItemOption[]
  verificationExceptions      VerificationException[]
  revisionSnapshots           BOQRevisionSnapshot[]
  rateCatalogueItems          RateCatalogueItem[]
  rateCataloguePriceHistories RateCataloguePriceHistory[]
  suppliers                   Supplier[]
  auditLogs                   AuditLog[]
  users                       User[]
  documentTemplates           DocumentTemplate[]
  generatedDocuments          GeneratedDocument[]
}

model User {
  id                          String                      @id @default(uuid()) @db.Uuid
  companyId                   String                      @db.Uuid
  email                       String                      @unique
  passwordHash                String
  fullName                    String
  role                        UserRole                    @default(ESTIMATOR)
  emailVerifiedAt             DateTime?
  isActive                    Boolean                     @default(true)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  company                     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions                    Session[]
  emailVerificationTokens     EmailVerificationToken[]
  passwordResetTokens         PasswordResetToken[]
  auditLogs                   AuditLog[]
  rateCataloguePriceHistories RateCataloguePriceHistory[]
  generatedDocuments          GeneratedDocument[]

  @@index([companyId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IndustryEngine {
  id                 String                  @id @default(uuid()) @db.Uuid
  key                String                  @unique
  name               String
  description        String
  isActive           Boolean                 @default(true)
  configJson         Json
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  companyIndustries  CompanyIndustryEngine[]
  projects           Project[]
  rateCatalogueItems RateCatalogueItem[]
  documentTemplates  DocumentTemplate[]
}

model CompanyIndustryEngine {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @db.Uuid
  industryEngineId String         @db.Uuid
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industryEngine   IndustryEngine @relation(fields: [industryEngineId], references: [id], onDelete: Cascade)

  @@unique([companyId, industryEngineId])
  @@index([companyId])
  @@index([industryEngineId])
  @@index([enabled])
}

model Client {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @db.Uuid
  name                  String
  companyName           String?
  email                 String?
  phone                 String?
  address               String?
  taxRegistrationNumber String?
  notes                 String?
  isArchived            Boolean   @default(false)
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects              Project[]

  @@index([companyId])
  @@index([email])
  @@index([isArchived])
}

model Project {
  id                    String                @id @default(uuid()) @db.Uuid
  companyId             String                @db.Uuid
  clientId              String                @db.Uuid
  industryEngineId      String                @db.Uuid
  slug                  String
  reference             String
  name                  String
  description           String?
  location              String?
  currency              String                @default("AED")
  taxRate               Decimal               @default(5) @db.Decimal(7, 4)
  language              String                @default("English")
  status                ProjectStatus         @default(DRAFT)
  currentRevisionNumber Int                   @default(1)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  company               Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client                Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  industryEngine        IndustryEngine        @relation(fields: [industryEngineId], references: [id], onDelete: Restrict)
  boqs                  BOQ[]
  revisionSnapshots     BOQRevisionSnapshot[]
  generatedDocuments    GeneratedDocument[]

  @@unique([companyId, reference])
  @@unique([companyId, slug])
  @@index([companyId])
  @@index([clientId])
  @@index([industryEngineId])
  @@index([status])
}

model BOQ {
  id                     String                  @id @default(uuid()) @db.Uuid
  companyId              String                  @db.Uuid
  projectId              String                  @db.Uuid
  title                  String
  revisionNumber         Int                     @default(1)
  status                 BOQStatus               @default(DRAFT)
  isLocked               Boolean                 @default(false)
  lockedAt               DateTime?
  approvedByName         String?
  discountPercentage     Decimal                 @default(0) @db.Decimal(7, 4)
  taxRate                Decimal                 @default(5) @db.Decimal(7, 4)
  version                Int                     @default(1)
  verifiedVersion        Int?
  verifiedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections               BOQSection[]
  verificationExceptions VerificationException[]
  revisionSnapshots      BOQRevisionSnapshot[]
  generatedDocuments     GeneratedDocument[]

  @@unique([projectId, revisionNumber])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model BOQSection {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  boqId       String    @db.Uuid
  code        String
  title       String
  description String    @default("")
  sortOrder   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  boq         BOQ       @relation(fields: [boqId], references: [id], onDelete: Cascade)
  items       BOQItem[]

  @@unique([boqId, code])
  @@index([companyId])
  @@index([boqId])
  @@index([sortOrder])
}

model BOQItem {
  id                     String                  @id @default(uuid()) @db.Uuid
  companyId              String                  @db.Uuid
  sectionId              String                  @db.Uuid
  itemNumber             Int
  itemCode               String
  category               String
  description            String
  specification          String                  @default("")
  quantity               Decimal                 @db.Decimal(18, 4)
  unit                   String
  unitCost               Decimal                 @default(0) @db.Decimal(18, 4)
  freightCost            Decimal                 @default(0) @db.Decimal(18, 4)
  installationCost       Decimal                 @default(0) @db.Decimal(18, 4)
  additionalCost         Decimal                 @default(0) @db.Decimal(18, 4)
  landedCost             Decimal                 @default(0) @db.Decimal(18, 4)
  marginMode             MarginMode              @default(MARKUP)
  marginPercentage       Decimal                 @default(0) @db.Decimal(7, 4)
  sellingRate            Decimal                 @default(0) @db.Decimal(18, 4)
  totalAmount            Decimal                 @default(0) @db.Decimal(20, 4)
  wastagePercentage      Decimal                 @default(0) @db.Decimal(7, 4)
  taxApplicable          Boolean                 @default(true)
  sourceReference        String                  @default("")
  roomOrZone             String                  @default("")
  drawingReference       String                  @default("")
  confidenceScore        Decimal                 @default(100) @db.Decimal(7, 4)
  status                 BOQItemStatus           @default(DRAFT)
  notes                  String                  @default("")
  pricingMetadataJson    Json?
  sortOrder              Int
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  section                BOQSection              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options                BOQItemOption[]
  verificationExceptions VerificationException[]

  @@index([companyId])
  @@index([sectionId])
  @@index([itemCode])
  @@index([status])
  @@index([sortOrder])
}

model BOQItemOption {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  boqItemId     String   @db.Uuid
  label         String
  description   String   @default("")
  specification String   @default("")
  rate          Decimal  @default(0) @db.Decimal(18, 4)
  isSelected    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  boqItem       BOQItem  @relation(fields: [boqItemId], references: [id], onDelete: Cascade)

  @@unique([boqItemId, label])
  @@index([companyId])
  @@index([boqItemId])
}

model VerificationException {
  id             String               @id @default(uuid()) @db.Uuid
  companyId      String               @db.Uuid
  boqId          String               @db.Uuid
  boqItemId      String?              @db.Uuid
  type           String
  severity       VerificationSeverity
  message        String
  currentValue   String?
  suggestedValue String?
  resolutionNote String?
  resolved       Boolean              @default(false)
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  boq            BOQ                  @relation(fields: [boqId], references: [id], onDelete: Cascade)
  boqItem        BOQItem?             @relation(fields: [boqItemId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([boqId])
  @@index([boqItemId])
  @@index([severity])
  @@index([resolved])
}

model BOQRevisionSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  projectId      String   @db.Uuid
  boqId          String   @db.Uuid
  revisionNumber Int
  snapshotJson   Json
  createdByName  String
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boq            BOQ      @relation(fields: [boqId], references: [id], onDelete: Cascade)

  @@unique([boqId, revisionNumber])
  @@index([companyId])
  @@index([projectId])
  @@index([boqId])
}

model Supplier {
  id                    String              @id @default(uuid()) @db.Uuid
  companyId             String              @db.Uuid
  name                  String
  legalName             String?
  email                 String?
  phone                 String?
  website               String?
  address               String?
  contactPerson         String?
  taxRegistrationNumber String?
  defaultCurrency       String              @default("AED")
  paymentTerms          String?
  leadTimeDays          Int?
  notes                 String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  catalogueItems        RateCatalogueItem[]

  @@index([companyId])
  @@index([name])
  @@index([email])
  @@index([isActive])
}

model RateCatalogueItem {
  id                         String                      @id @default(uuid()) @db.Uuid
  companyId                  String                      @db.Uuid
  industryEngineId           String                      @db.Uuid
  supplierId                 String?                     @db.Uuid
  itemCode                   String
  category                   String
  subcategory                String?
  description                String
  specification              String?
  unit                       String
  manufacturer               String?
  brand                      String?
  model                      String?
  countryOfOrigin            String?
  baseCost                   Decimal                     @db.Decimal(18, 4)
  freightCost                Decimal                     @default(0) @db.Decimal(18, 4)
  installationCost           Decimal                     @default(0) @db.Decimal(18, 4)
  additionalCost             Decimal                     @default(0) @db.Decimal(18, 4)
  landedCost                 Decimal                     @default(0) @db.Decimal(18, 4)
  marginMode                 MarginMode                  @default(MARKUP)
  defaultMargin              Decimal                     @default(0) @db.Decimal(7, 4)
  sellingRate                Decimal                     @default(0) @db.Decimal(18, 4)
  minimumSellingRate         Decimal?                    @db.Decimal(18, 4)
  currency                   String                      @default("AED")
  effectiveDate              DateTime
  expiryDate                 DateTime?
  status                     RateStatus                  @default(ACTIVE)
  sourceReference            String?
  supplierQuotationReference String?
  metadataJson               Json?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industryEngine             IndustryEngine              @relation(fields: [industryEngineId], references: [id], onDelete: Restrict)
  supplier                   Supplier?                   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  priceHistory               RateCataloguePriceHistory[]

  @@unique([companyId, itemCode])
  @@index([companyId])
  @@index([industryEngineId])
  @@index([supplierId])
  @@index([itemCode])
  @@index([category])
  @@index([status])
  @@index([expiryDate])
}

model RateCataloguePriceHistory {
  id                       String            @id @default(uuid()) @db.Uuid
  companyId                String            @db.Uuid
  rateCatalogueItemId      String            @db.Uuid
  previousBaseCost         Decimal           @db.Decimal(18, 4)
  newBaseCost              Decimal           @db.Decimal(18, 4)
  previousFreightCost      Decimal           @db.Decimal(18, 4)
  newFreightCost           Decimal           @db.Decimal(18, 4)
  previousInstallationCost Decimal           @db.Decimal(18, 4)
  newInstallationCost      Decimal           @db.Decimal(18, 4)
  previousAdditionalCost   Decimal           @db.Decimal(18, 4)
  newAdditionalCost        Decimal           @db.Decimal(18, 4)
  previousLandedCost       Decimal           @db.Decimal(18, 4)
  newLandedCost            Decimal           @db.Decimal(18, 4)
  previousMargin           Decimal           @db.Decimal(7, 4)
  newMargin                Decimal           @db.Decimal(7, 4)
  previousSellingRate      Decimal           @db.Decimal(18, 4)
  newSellingRate           Decimal           @db.Decimal(18, 4)
  currency                 String
  effectiveDate            DateTime
  expiryDate               DateTime?
  changedByUserId          String?           @db.Uuid
  changeReason             String?
  createdAt                DateTime          @default(now())
  company                  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rateCatalogueItem        RateCatalogueItem @relation(fields: [rateCatalogueItemId], references: [id], onDelete: Cascade)
  changedByUser            User?             @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([rateCatalogueItemId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  userId      String?  @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  action      String
  payloadJson Json
  actorName   String
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([userId])
}

model DocumentTemplate {
  id                 String               @id @default(uuid()) @db.Uuid
  companyId          String               @db.Uuid
  industryEngineId   String?              @db.Uuid
  name               String
  code               String
  type               DocumentTemplateType
  description        String               @default("")
  styleConfigJson    Json
  contentConfigJson  Json
  isDefault          Boolean              @default(false)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industryEngine     IndustryEngine?      @relation(fields: [industryEngineId], references: [id], onDelete: SetNull)
  generatedDocuments GeneratedDocument[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([industryEngineId])
  @@index([type])
  @@index([isActive])
}

model GeneratedDocument {
  id                     String                  @id @default(uuid()) @db.Uuid
  companyId              String                  @db.Uuid
  projectId              String                  @db.Uuid
  boqId                  String                  @db.Uuid
  templateId             String                  @db.Uuid
  revisionNumber         Int
  type                   GeneratedDocumentType
  audience               DocumentAudience
  status                 GeneratedDocumentStatus @default(QUEUED)
  isDraft                Boolean                 @default(false)
  storageKey             String?
  fileName               String?
  mimeType               String?
  fileSize               Int?
  checksum               String?
  generatedByUserId      String?                 @db.Uuid
  generatedByName        String
  generationMetadataJson Json?
  errorMessage           String?
  createdAt              DateTime                @default(now())
  completedAt            DateTime?
  failedAt               DateTime?
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boq                    BOQ                     @relation(fields: [boqId], references: [id], onDelete: Cascade)
  template               DocumentTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  generatedByUser        User?                   @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([boqId])
  @@index([templateId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}
