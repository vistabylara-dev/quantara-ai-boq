/// MASTER-BOQ-1A — arbitrary-depth classification tree (Industry -> Discipline
/// -> System -> Category -> Subcategory -> Item Family). A single
/// self-referential node model is used instead of one table per level so the
/// hierarchy can grow (new industries/disciplines) without further migrations.
/// MASTER-SCALE-1A — extended with SUBSYSTEM (between System and Category)
/// and ITEM_TYPE (between Item Family and Variant) so the deep example in
/// the addendum (Mechanical -> HVAC -> Fans -> Axial Fans -> Smoke Extract
/// Fan -> High-Temperature Rated -> ...) is representable without another
/// migration. Existing rows (all currently INDUSTRY/DISCIPLINE/SYSTEM/
/// CATEGORY from the HVAC backfill) are unaffected — enum values are
/// additive.
enum MasterHierarchyNodeType {
  INDUSTRY
  DISCIPLINE
  SYSTEM
  SUBSYSTEM
  CATEGORY
  SUBCATEGORY
  ITEM_FAMILY
  ITEM_TYPE
}

/// Workflow state of one MasterItemVersion — separate from MasterItem.status
/// (which is the item's overall lifecycle: DRAFT/ACTIVE/DEPRECATED/ARCHIVED).
enum MasterItemVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

/// MASTER-SCALE-1A — added SMM7/CESMM/NRM/UNIFORMAT_II (Uniformat II is
/// tracked separately from the original UniFormat entry rather than
/// replacing it, since they are distinct systems) and OTHER as an escape
/// hatch for a national/regional classification system that doesn't yet
/// warrant its own enum value — the free-text `code`/`label` columns on
/// MasterItemClassification carry the actual system-specific value.
enum MasterClassificationSystem {
  MASTERFORMAT_2020
  CSI
  OMNICLASS
  UNIFORMAT
  UNIFORMAT_II
  IFC
  NRM
  SMM7
  CESMM
  INTERNAL_QUANTARA
  REVIT_CATEGORY
  CAD_LAYER
  REGIONAL_CODE
  COST_CODE
  OTHER
}

