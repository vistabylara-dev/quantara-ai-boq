/// TEMPLATE-LINK-1 — the DRAFT->REVIEW->APPROVED->PUBLISHED->RETIRED lifecycle
/// shared by all three template-version tables below (mirrors
/// MasterItemVersionStatus, which established this exact pattern for the
/// master catalogue). A template row's PUBLISHED version is never
/// destructively overwritten by a later edit — publishing a new version
/// retires the previous one instead, and every already-generated document /
/// sent email / locked BOQ keeps pointing at the exact version it used.
enum TemplateVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

model DocumentTemplate {
  id                 String                    @id @default(uuid()) @db.Uuid
  companyId          String                    @db.Uuid
  industryEngineId   String?                   @db.Uuid
  name               String
  code               String
  type               DocumentTemplateType
  description        String                    @default("")
  styleConfigJson    Json
  contentConfigJson  Json
  isDefault          Boolean                   @default(false)
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industryEngine     IndustryEngine?           @relation(fields: [industryEngineId], references: [id], onDelete: SetNull)
  generatedDocuments GeneratedDocument[]
  companyBrandings   CompanyBranding[]
  versions           DocumentTemplateVersion[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([industryEngineId])
  @@index([type])
  @@index([isActive])
}

/// A pinned, immutable snapshot of one DocumentTemplate's style/content
/// config at a point in time. GeneratedDocument.templateVersionId locks each
/// rendered output to the exact version that produced it — editing/publishing
/// a new version afterward never changes an already-generated document.
model DocumentTemplateVersion {
  id                 String                @id @default(uuid()) @db.Uuid
  documentTemplateId String                @db.Uuid
  versionNumber      Int
  status             TemplateVersionStatus @default(DRAFT)
  styleConfigJson    Json
  contentConfigJson  Json
  changeSummary      String                @default("")
  effectiveDate      DateTime?
  retiredDate        DateTime?
  createdByUserId    String?               @db.Uuid
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  documentTemplate   DocumentTemplate      @relation(fields: [documentTemplateId], references: [id], onDelete: Cascade)
  createdByUser      User?                 @relation("DocumentTemplateVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  generatedDocuments GeneratedDocument[]

  @@unique([documentTemplateId, versionNumber])
  @@index([documentTemplateId])
  @@index([status])
}

model GeneratedDocument {
  id                     String                   @id @default(uuid()) @db.Uuid
  companyId              String                   @db.Uuid
  projectId              String                   @db.Uuid
  boqId                  String                   @db.Uuid
  templateId             String                   @db.Uuid
  /// TEMPLATE-LINK-1 — nullable so pre-existing rows (generated before
  /// versioning existed) remain valid; backfilled to each row's template's
  /// version 1. Every new generation sets this to the exact PUBLISHED
  /// version resolved at generation time.
  templateVersionId      String?                  @db.Uuid
  revisionNumber         Int
  type                   GeneratedDocumentType
  audience               DocumentAudience
  status                 GeneratedDocumentStatus  @default(QUEUED)
  isDraft                Boolean                  @default(false)
  storageKey             String?
  fileName               String?
  mimeType               String?
  fileSize               Int?
  checksum               String?
  generatedByUserId      String?                  @db.Uuid
  generatedByName        String
  generationMetadataJson Json?
  errorMessage           String?
  createdAt              DateTime                 @default(now())
  completedAt            DateTime?
  failedAt               DateTime?
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boq                    BOQ                      @relation(fields: [boqId], references: [id], onDelete: Cascade)
  template               DocumentTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion        DocumentTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  generatedByUser        User?                    @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)
  proposalDocuments      ClientProposalDocument[]

  @@index([companyId])
  @@index([projectId])
  @@index([boqId])
  @@index([templateId])
  @@index([templateVersionId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

/// A reusable, section-based report template (e.g. an FM/technical condition-report standard) —
/// standalone from BOQ/GeneratedDocument on purpose, since a technical report is not necessarily
/// generated from a priced BOQ. `sectionsJson` holds the full structured content (front matter +
/// ordered sections of heading/paragraph/table/callout blocks, matching the JSON shape produced by
/// the template-import tooling) — the same shape `GeneratedTechnicalReport.sectionsSnapshotJson`
/// copies at creation time so a later template edit never silently changes an in-flight report.
model TechnicalReportTemplate {
  id               String                           @id @default(uuid()) @db.Uuid
  companyId        String                           @db.Uuid
  name             String
  code             String
  disciplineTag    String                           @default("")
  description      String                           @default("")
  sectionsJson     Json
  isDefault        Boolean                          @default(false)
  isActive         Boolean                          @default(true)
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  company          Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedReports GeneratedTechnicalReport[]
  versions         TechnicalReportTemplateVersion[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
}

/// A pinned, immutable snapshot of one TechnicalReportTemplate's sectionsJson
/// at a point in time — GeneratedTechnicalReport already snapshots sections
/// at creation (sectionsSnapshotJson) independent of this, but templateVersionId
/// additionally records which governed version that snapshot came from, so
/// the admin Template Centre can show real usage/version history.
model TechnicalReportTemplateVersion {
  id                        String                     @id @default(uuid()) @db.Uuid
  technicalReportTemplateId String                     @db.Uuid
  versionNumber             Int
  status                    TemplateVersionStatus      @default(DRAFT)
  sectionsJson              Json
  changeSummary             String                     @default("")
  effectiveDate             DateTime?
  retiredDate               DateTime?
  createdByUserId           String?                    @db.Uuid
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  technicalReportTemplate   TechnicalReportTemplate    @relation(fields: [technicalReportTemplateId], references: [id], onDelete: Cascade)
  createdByUser             User?                      @relation("TechnicalReportTemplateVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  generatedReports          GeneratedTechnicalReport[]

  @@unique([technicalReportTemplateId, versionNumber])
  @@index([technicalReportTemplateId])
  @@index([status])
}

/// One filled-in (or in-progress) instance of a TechnicalReportTemplate for a specific project.
/// `placeholdersJson` is the list of distinct bracketed placeholder strings found in the template
/// snapshot at creation time (e.g. "[Insert project or property name]"); `fieldValuesJson` maps
/// each of those placeholder strings to the value a user has typed in. Generation performs a
/// literal substitution pass over the section snapshot using that map — no inference, no invented
/// values, matching the rest of this codebase's no-fake-AI discipline.
model GeneratedTechnicalReport {
  id                   String                          @id @default(uuid()) @db.Uuid
  companyId            String                          @db.Uuid
  projectId            String                          @db.Uuid
  templateId           String                          @db.Uuid
  /// TEMPLATE-LINK-1 — nullable for the same pre-versioning-backfill reason as
  /// GeneratedDocument.templateVersionId.
  templateVersionId    String?                         @db.Uuid
  name                 String
  status               TechnicalReportStatus           @default(DRAFT)
  sectionsSnapshotJson Json
  placeholdersJson     Json
  fieldValuesJson      Json
  documentType         GeneratedDocumentType?
  storageKey           String?
  fileName             String?
  mimeType             String?
  fileSize             Int?
  checksum             String?
  generatedByUserId    String?                         @db.Uuid
  generatedByName      String
  errorMessage         String?
  /// Client-facing secure link (email service 1B) — same generate-raw/store-hash-only pattern as
  /// ClientProposal.tokenHash (see auth/tokens.ts + proposals/proposal-token.ts). Nullable: most
  /// reports are never shared via link (attachment-only email is equally valid). Rotating the link
  /// (creating a new one) simply overwrites this hash; the previous raw token stops resolving.
  shareTokenHash       String?                         @unique
  shareExpiresAt       DateTime?
  shareRevokedAt       DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  completedAt          DateTime?
  company              Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project              Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template             TechnicalReportTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion      TechnicalReportTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  generatedByUser      User?                           @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)
  emailDispatches      EmailDispatch[]

  @@index([companyId])
  @@index([projectId])
  @@index([templateId])
  @@index([templateVersionId])
  @@index([status])
  @@index([createdAt])
}

/// Email service 1B follow-up — which send flow a template is meant for. Existing rows (all
/// created before this column existed, i.e. the BOQ proposal templates) backfill to BOQ, matching
/// what they actually are; new templates must pick one explicitly at creation. Send pickers filter
/// by this so a company can never accidentally pick a BOQ template for a technical report or vice
/// versa — the actual "safe user journey" this was added for.
enum EmailTemplateCategory {
  BOQ
  TECHNICAL_REPORT
  GENERAL
}

model EmailTemplate {
  id              String                 @id @default(uuid()) @db.Uuid
  companyId       String                 @db.Uuid
  name            String
  code            String
  category        EmailTemplateCategory  @default(BOQ)
  subject         String
  bodyHtml        String
  bodyText        String
  language        String                 @default("English")
  isDefault       Boolean                @default(false)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emailDispatches EmailDispatch[]
  versions        EmailTemplateVersion[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
}

/// A pinned, immutable snapshot of one EmailTemplate's subject/body at a
/// point in time. EmailDispatch.emailTemplateVersionId locks every sent (or
/// test-sent) email's audit record to the exact version that generated it —
/// editing the template afterward never rewrites delivery history.
model EmailTemplateVersion {
  id              String                @id @default(uuid()) @db.Uuid
  emailTemplateId String                @db.Uuid
  versionNumber   Int
  status          TemplateVersionStatus @default(DRAFT)
  subject         String
  bodyHtml        String
  bodyText        String
  changeSummary   String                @default("")
  effectiveDate   DateTime?
  retiredDate     DateTime?
  createdByUserId String?               @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  emailTemplate   EmailTemplate         @relation(fields: [emailTemplateId], references: [id], onDelete: Cascade)
  createdByUser   User?                 @relation("EmailTemplateVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  emailDispatches EmailDispatch[]

  @@unique([emailTemplateId, versionNumber])
  @@index([emailTemplateId])
  @@index([status])
}

model ClientProposal {
  id                  String                   @id @default(uuid()) @db.Uuid
  companyId           String                   @db.Uuid
  projectId           String                   @db.Uuid
  boqId               String                   @db.Uuid
  revisionNumber      Int
  clientId            String                   @db.Uuid
  createdByUserId     String?                  @db.Uuid
  createdByName       String
  recipientEmail      String
  recipientName       String
  tokenHash           String                   @unique
  status              ClientProposalStatus     @default(DRAFT)
  expiresAt           DateTime
  revokedAt           DateTime?
  firstOpenedAt       DateTime?
  lastOpenedAt        DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  revisionRequestedAt DateTime?
  clientComment       String?
  approvalName        String?
  approvalEmail       String?
  rejectionReason     String?
  selectedOptionsJson Json?
  settingsJson        Json
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boq                 BOQ                      @relation(fields: [boqId], references: [id], onDelete: Cascade)
  client              Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdByUser       User?                    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents           ClientProposalDocument[]
  events              ClientProposalEvent[]
  emailDispatches     EmailDispatch[]

  @@index([companyId])
  @@index([projectId])
  @@index([boqId])
  @@index([tokenHash])
  @@index([status])
  @@index([expiresAt])
}

model ClientProposalDocument {
  id                  String            @id @default(uuid()) @db.Uuid
  companyId           String            @db.Uuid
  clientProposalId    String            @db.Uuid
  generatedDocumentId String            @db.Uuid
  createdAt           DateTime          @default(now())
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientProposal      ClientProposal    @relation(fields: [clientProposalId], references: [id], onDelete: Cascade)
  generatedDocument   GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)

  @@unique([clientProposalId, generatedDocumentId])
  @@index([companyId])
  @@index([clientProposalId])
}

model ClientProposalEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  companyId        String                  @db.Uuid
  clientProposalId String                  @db.Uuid
  eventType        ClientProposalEventType
  actorType        ProposalActorType
  actorUserId      String?                 @db.Uuid
  actorName        String?
  actorEmail       String?
  ipHash           String?
  userAgentSummary String?
  metadataJson     Json?
  createdAt        DateTime                @default(now())
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientProposal   ClientProposal          @relation(fields: [clientProposalId], references: [id], onDelete: Cascade)
  actorUser        User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clientProposalId])
  @@index([eventType])
}

model EmailDispatch {
  id                         String                    @id @default(uuid()) @db.Uuid
  companyId                  String                    @db.Uuid
  projectId                  String                    @db.Uuid
  boqId                      String?                   @db.Uuid
  clientProposalId           String?                   @db.Uuid
  /// Email service 1B — additive nullable link so a technical-report send is logged/audited through
  /// the exact same dispatch table as proposal emails, without touching any existing BOQ/proposal row.
  generatedTechnicalReportId String?                   @db.Uuid
  emailTemplateId            String?                   @db.Uuid
  /// TEMPLATE-LINK-1 — nullable for the same pre-versioning-backfill reason
  /// as GeneratedDocument.templateVersionId; every new send sets this to the
  /// exact PUBLISHED version resolveTemplate() returned.
  emailTemplateVersionId     String?                   @db.Uuid
  createdByUserId            String?                   @db.Uuid
  createdByName              String
  recipient                  String
  ccJson                     Json?
  bccJson                    Json?
  replyTo                    String?
  subject                    String
  bodyHtml                   String
  bodyText                   String
  provider                   String
  providerMessageId          String?
  status                     EmailDispatchStatus       @default(DRAFT)
  attempts                   Int                       @default(0)
  sentAt                     DateTime?
  deliveredAt                DateTime?
  failedAt                   DateTime?
  errorCode                  String?
  errorMessage               String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  company                    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                    Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boq                        BOQ?                      @relation(fields: [boqId], references: [id], onDelete: SetNull)
  clientProposal             ClientProposal?           @relation(fields: [clientProposalId], references: [id], onDelete: SetNull)
  generatedTechnicalReport   GeneratedTechnicalReport? @relation(fields: [generatedTechnicalReportId], references: [id], onDelete: SetNull)
  emailTemplate              EmailTemplate?            @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  emailTemplateVersion       EmailTemplateVersion?     @relation(fields: [emailTemplateVersionId], references: [id], onDelete: SetNull)
  createdByUser              User?                     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([clientProposalId])
  @@index([generatedTechnicalReportId])
  @@index([emailTemplateVersionId])
  @@index([status])
}

/**
 * Phase 8 — an uploaded source file (drawing, schedule, photo, spreadsheet,
 * report, etc.) awaiting or undergoing AI-assisted extraction/inspection
 * processing. Distinct from GeneratedDocument, which is an already-rendered
 * *output* of the platform (a BOQ export). The original upload is never
 * overwritten; derivative artifacts (previews, pages, extracted data,
 * annotations) are stored separately under their own storage-key prefixes.
 */
model ProjectFile {
  id                              String                    @id @default(uuid()) @db.Uuid
  companyId                       String                    @db.Uuid
  projectId                       String                    @db.Uuid
  uploadedByUserId                String                    @db.Uuid
  originalName                    String
  safeFileName                    String
  storageKey                      String
  mimeType                        String
  extension                       String
  fileSize                        Int
  checksum                        String
  classification                  ProjectFileClassification @default(UNKNOWN)
  classificationConfidence        Decimal?                  @db.Decimal(5, 2)
  classificationConfirmedByUserId String?                   @db.Uuid
  classificationConfirmedAt       DateTime?
  status                          ProjectFileStatus         @default(UPLOADED)
  language                        String?
  pageCount                       Int?
  sheetCount                      Int?
  drawingNumber                   String?
  drawingTitle                    String?
  revisionNumber                  String?
  scaleText                       String?
  detectedScale                   String?
  measurementUnit                 String?
  metadataJson                    Json?
  processingErrorCode             String?
  processingErrorMessage          String?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  company                         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedByUser                  User                      @relation("ProjectFileUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  classificationConfirmedByUser   User?                     @relation("ProjectFileClassificationConfirmedByUser", fields: [classificationConfirmedByUserId], references: [id], onDelete: SetNull)
  extractionJobs                  ExtractionJob[]
  extractedTables                 ExtractedTable[]
  drawingPages                    DrawingPage[]
  extractedEntities               ExtractedEntity[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([classification])
  @@index([companyId, checksum])
}

enum ProjectFileClassification {
  ARCHITECTURAL_PLAN
  STRUCTURAL_PLAN
  FURNITURE_LAYOUT
  INTERIOR_LAYOUT
  REFLECTED_CEILING_PLAN
  FLOORING_PLAN
  LIGHTING_PLAN
  ELECTRICAL_PLAN
  HVAC_PLAN
  PLUMBING_PLAN
  DRAINAGE_PLAN
  FIRE_FIGHTING_PLAN
  FIRE_ALARM_PLAN
  ELV_PLAN
  JOINERY_DRAWING
  LANDSCAPE_PLAN
  ELEVATION
  SECTION
  DETAIL_DRAWING
  MATERIAL_SCHEDULE
  FURNITURE_SCHEDULE
  EQUIPMENT_SCHEDULE
  DOOR_SCHEDULE
  WINDOW_SCHEDULE
  FINISH_SCHEDULE
  SUPPLIER_PRICE_LIST
  EXISTING_BOQ
  PRODUCT_CATALOGUE
  SITE_INSPECTION_PHOTO
  TEST_REPORT
  METHOD_STATEMENT
  TECHNICAL_REPORT
  UNKNOWN
}

enum ProjectFileStatus {
  UPLOADED
  CLASSIFYING
  CLASSIFIED
  PREPROCESSING
  READY_FOR_PROCESSING
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
  FAILED
  CANCELLED
  ARCHIVED
}

/**
 * Phase 8 — a single unit of background processing work against a
 * ProjectFile (classification, extraction, detection, etc.). Always
 * created before any large/slow processing starts; API route handlers only
 * ever enqueue a job and return, never run the work inline (spec section 1
 * anti-drift rule against synchronous large-file processing in request
 * handlers). Processed by the queue in src/lib/jobs/*.
 */
model ExtractionJob {
  id                 String               @id @default(uuid()) @db.Uuid
  companyId          String               @db.Uuid
  projectId          String               @db.Uuid
  projectFileId      String               @db.Uuid
  engineType         ExtractionEngineType
  provider           String               @default("local")
  status             ExtractionJobStatus  @default(QUEUED)
  progressPercentage Int                  @default(0)
  currentStep        String?
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  attempts           Int                  @default(0)
  maximumAttempts    Int                  @default(3)
  configurationJson  Json?
  resultSummaryJson  Json?
  usageMetadataJson  Json?
  errorCode          String?
  errorMessage       String?
  createdByUserId    String               @db.Uuid
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectFile        ProjectFile          @relation(fields: [projectFileId], references: [id], onDelete: Cascade)
  createdByUser      User                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
  @@index([projectFileId])
  @@index([status])
  @@index([engineType])
}

enum ExtractionEngineType {
  DOCUMENT_CLASSIFICATION
  FILE_PREPROCESSING
  PDF_TEXT_EXTRACTION
  OCR_TEXT_EXTRACTION
  TABLE_EXTRACTION
  TITLE_BLOCK_EXTRACTION
  SCALE_DETECTION
  VECTOR_EXTRACTION
  ROOM_BOUNDARY_DETECTION
  OBJECT_DETECTION
  SYMBOL_DETECTION
  QUANTITY_CALCULATION
  PRODUCT_MATCHING
  PHOTO_ANALYSIS
  FINDINGS_DRAFTING
  REPORT_DRAFTING
  VERIFICATION_GENERATION
}

enum ExtractionJobStatus {
  QUEUED
  RUNNING
  NEEDS_INPUT
  NEEDS_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

/**
 * Phase 8 section 11 — a table/schedule extracted from a source file (CSV,
 * XLSX, or a text-based PDF). `drawingPageId` is included per the spec's
 * field list for a future sub-phase (drawing viewer) that introduces the
 * DrawingPage model; it is a plain nullable id column with no FK constraint
 * yet — the constraint is added once DrawingPage exists, in that sub-phase's
 * own migration, rather than guessing at that model's shape now.
 */
model ExtractedTable {
  id                   String               @id @default(uuid()) @db.Uuid
  companyId            String               @db.Uuid
  projectFileId        String               @db.Uuid
  drawingPageId        String?              @db.Uuid
  sheetName            String?
  title                String?
  tableType            ExtractedTableType   @default(UNKNOWN)
  confidence           Decimal              @db.Decimal(5, 2)
  boundingGeometryJson Json?
  sourceReference      String?
  status               ExtractedTableStatus @default(EXTRACTED)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectFile          ProjectFile          @relation(fields: [projectFileId], references: [id], onDelete: Cascade)
  rows                 ExtractedTableRow[]

  @@index([companyId])
  @@index([projectFileId])
  @@index([status])
  @@index([tableType])
}

/**
 * A parent row carries the columns shared across a merged/grouped range
 * (e.g. "Element: Foundations", "Concrete: 53 m3" spanning several source
 * rows); its child rows carry only the columns that vary per source row
 * (e.g. reinforcement diameter + quantity) — never a copy of the parent's
 * quantity columns, so summing children never double-counts the parent
 * value (spec section 12).
 */
model ExtractedTableRow {
  id                 String               @id @default(uuid()) @db.Uuid
  companyId          String               @db.Uuid
  extractedTableId   String               @db.Uuid
  rowNumber          Int
  parentRowId        String?              @db.Uuid
  normalizedDataJson Json?
  rawDataJson        Json?
  confidence         Decimal              @db.Decimal(5, 2)
  status             ExtractedTableStatus @default(EXTRACTED)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  extractedTable     ExtractedTable       @relation(fields: [extractedTableId], references: [id], onDelete: Cascade)
  parentRow          ExtractedTableRow?   @relation("ExtractedTableRowParent", fields: [parentRowId], references: [id], onDelete: Cascade)
  childRows          ExtractedTableRow[]  @relation("ExtractedTableRowParent")
  cells              ExtractedTableCell[]

  @@index([companyId])
  @@index([extractedTableId])
  @@index([parentRowId])
  @@index([status])
}

model ExtractedTableCell {
  id                   String            @id @default(uuid()) @db.Uuid
  companyId            String            @db.Uuid
  extractedTableRowId  String            @db.Uuid
  columnKey            String
  rawValue             String?
  normalizedValue      String?
  confidence           Decimal           @db.Decimal(5, 2)
  sourceCellReference  String?
  boundingGeometryJson Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  extractedTableRow    ExtractedTableRow @relation(fields: [extractedTableRowId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([extractedTableRowId])
}

enum ExtractedTableType {
  SUPPLIER_QUOTATION
  EXISTING_BOQ
  FURNITURE_SCHEDULE
  EQUIPMENT_SCHEDULE
  STRUCTURAL_QUANTITY_SCHEDULE
  DOOR_SCHEDULE
  WINDOW_SCHEDULE
  FINISH_SCHEDULE
  MATERIAL_SCHEDULE
  GENERIC_TABLE
  UNKNOWN
}

enum ExtractedTableStatus {
  EXTRACTED
  NEEDS_REVIEW
  CONFIRMED
  CORRECTED
  REJECTED
}

/**
 * Phase 8 section 7/16 — one viewable/rasterized page of a drawing file (a PDF page, or the single implicit page of a standalone image).
 */
model DrawingPage {
  id                   String                    @id @default(uuid()) @db.Uuid
  companyId            String                    @db.Uuid
  projectFileId        String                    @db.Uuid
  pageNumber           Int
  sheetName            String?
  width                Int?
  height               Int?
  dpi                  Int?
  imageStorageKey      String?
  thumbnailStorageKey  String?
  vectorDataStorageKey String?
  textLayerJson        Json?
  titleBlockJson       Json?
  detectedScale        String?
  scaleUnit            String?
  scaleConfidence      Decimal?                  @db.Decimal(5, 2)
  orientation          String?
  cropBoxJson          Json?
  processingStatus     String                    @default("PENDING")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  company              Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectFile          ProjectFile               @relation(fields: [projectFileId], references: [id], onDelete: Cascade)
  layers               DrawingLayer[]
  scaleCalibrations    DrawingScaleCalibration[]

  @@unique([projectFileId, pageNumber])
  @@index([companyId])
  @@index([projectFileId])
}

model DrawingLayer {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @db.Uuid
  drawingPageId   String      @db.Uuid
  name            String
  layerType       String?
  sourceLayerName String?
  isVisible       Boolean     @default(true)
  metadataJson    Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drawingPage     DrawingPage @relation(fields: [drawingPageId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([drawingPageId])
}

/**
 * Phase 8 section 15 — spatial quantities are blocked without a verified calibration per page; a detected scale is only ever a suggestion, never auto-trusted.
 */
model DrawingScaleCalibration {
  id                 String               @id @default(uuid()) @db.Uuid
  companyId          String               @db.Uuid
  drawingPageId      String               @db.Uuid
  calibrationType    ScaleCalibrationType
  scaleRatio         Decimal              @db.Decimal(14, 6)
  drawingUnit        String
  realWorldUnit      String
  sourceText         String?
  sourceGeometryJson Json?
  confidence         Decimal?             @db.Decimal(5, 2)
  isVerified         Boolean              @default(false)
  verifiedByUserId   String?              @db.Uuid
  verifiedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drawingPage        DrawingPage          @relation(fields: [drawingPageId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([drawingPageId])
}

enum ScaleCalibrationType {
  DETECTED_SCALE_TEXT
  KNOWN_DIMENSION
  TWO_POINT
  VECTOR_UNIT
  MANUAL_INPUT
}

/**
 * Phase 8 section 17 — a detected/manually-entered spatial or schedule item awaiting human verification. Covers rooms, furniture, MEP equipment, and more via entityType; never auto-trusted.
 */
model ExtractedEntity {
  id                          String                @id @default(uuid()) @db.Uuid
  companyId                   String                @db.Uuid
  projectId                   String                @db.Uuid
  projectFileId               String                @db.Uuid
  drawingPageId               String?               @db.Uuid
  extractionJobId             String?               @db.Uuid
  entityType                  ExtractedEntityType
  categoryKey                 String?
  label                       String
  normalizedLabel             String?
  quantity                    Decimal?              @db.Decimal(14, 4)
  unit                        String?
  confidence                  Decimal               @db.Decimal(5, 2)
  extractionMethod            ExtractionMethod      @default(MANUAL)
  boundingGeometryJson        Json?
  sourceText                  String?
  sourceReference             String?
  technicalDataJson           Json?
  matchedMasterItemId         String?               @db.Uuid
  matchedCompanyLibraryItemId String?               @db.Uuid
  matchedCatalogueItemId      String?               @db.Uuid
  status                      ExtractedEntityStatus @default(EXTRACTED)
  confirmedByUserId           String?               @db.Uuid
  confirmedAt                 DateTime?
  rejectedByUserId            String?               @db.Uuid
  rejectedAt                  DateTime?
  correctionJson              Json?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  company                     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectFile                 ProjectFile           @relation(fields: [projectFileId], references: [id], onDelete: Cascade)
  quantityCalculations        QuantityCalculation[]

  @@index([companyId])
  @@index([projectId])
  @@index([projectFileId])
  @@index([status])
  @@index([entityType])
}

enum ExtractedEntityType {
  ROOM
  FURNITURE
  EQUIPMENT
  MATERIAL
  FIXTURE
  ELECTRICAL_POINT
  LIGHT_FIXTURE
  HVAC_EQUIPMENT
  FAN
  DUCT
  DIFFUSER
  GRILLE
  DAMPER
  PIPE
  VALVE
  SANITARY_FIXTURE
  FIRE_FIGHTING_ITEM
  FIRE_ALARM_ITEM
  DOOR
  WINDOW
  PARTITION
  WALL_FINISH
  FLOOR_FINISH
  CEILING_FINISH
  STRUCTURAL_ELEMENT
  SCHEDULE_ROW
  ANNOTATION
  CUSTOM
}

enum ExtractionMethod {
  TEXT_LAYER
  OCR
  TABLE_PARSER
  VECTOR_BLOCK
  VISION_MODEL
