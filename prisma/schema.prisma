model MasterItem {
  id                         String                            @id @default(uuid()) @db.Uuid
  disciplineId               String                            @db.Uuid
  categoryId                 String                            @db.Uuid
  itemCode                   String
  name                       String
  shortDescription           String                            @default("")
  fullDescription            String                            @default("")
  defaultUnit                String
  defaultSpecificationJson   Json?
  technicalFieldsJson        Json?
  defaultTagsJson            Json?
  searchKeywordsJson         Json?
  synonymsJson               Json?
  defaultManufacturerType    String?
  defaultInstallationMethod  String?
  defaultTestingRequirement  String?
  defaultWarrantyRequirement String?
  defaultDocumentLabelsJson  Json?
  version                    Int                               @default(1)
  status                     MasterItemStatus                  @default(ACTIVE)
  isPremium                  Boolean                           @default(true)
  sourceBatchId              String?                           @db.Uuid
  /// MASTER-BOQ-1A — deepest known node in the new deep hierarchy (usually
  /// Item Family, but Subcategory or Category if a family hasn't been
  /// defined yet, e.g. for the existing HVAC data). Nullable and additive:
  /// existing rows keep working through disciplineId/categoryId unchanged.
  hierarchyNodeId            String?                           @db.Uuid
  replacementItemId          String?                           @db.Uuid
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
  discipline                 MasterDiscipline                  @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  category                   MasterCategory                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sourceBatch                MasterCatalogueImportBatch?       @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)
  hierarchyNode              MasterHierarchyNode?              @relation(fields: [hierarchyNodeId], references: [id], onDelete: SetNull)
  replacementItem            MasterItem?                       @relation("MasterItemReplacement", fields: [replacementItemId], references: [id], onDelete: SetNull)
  replacedByItems            MasterItem[]                      @relation("MasterItemReplacement")
  packageItems               IndustryDataPackageItem[]
  trialUnlocks               TrialPremiumItemUnlock[]
  libraryItems               CompanyLibraryItem[]
  boqItems                   BOQItem[]
  versions                   MasterItemVersion[]
  variants                   MasterItemVariant[]
  classifications            MasterItemClassification[]
  regionalApplicability      MasterItemRegionalApplicability[]
  drawingProfile             MasterItemDrawingProfile?
  attributeValues            MasterItemAttributeValue[]
  relationsFrom              MasterItemRelation[]              @relation("MasterItemRelationFrom")
  relationsTo                MasterItemRelation[]              @relation("MasterItemRelationTo")
  certifications             ProductCertification[]
  standardApplicabilities    MasterItemStandardApplicability[]

  @@unique([disciplineId, itemCode])
  @@index([disciplineId])
  @@index([categoryId])
  @@index([status])
  @@index([isPremium])
  @@index([name])
  @@index([sourceBatchId])
  @@index([hierarchyNodeId])
  @@index([replacementItemId])
}

/// MASTER-BOQ-1A reuses this existing model as the "Attribute Definition"
/// half of the definition+value pattern (it already had code/label/type/
/// unit/options/validation/required/searchable/filterable/order) rather than
/// building a duplicate table. isActive, unitFamily, allowedUnitsJson, and
/// applicableHierarchyNodeId are additive columns for the new requirements;
/// MasterItemAttributeValue below is the new "Attribute Value" half.
model TechnicalFieldDefinition {
  id                        String                     @id @default(uuid()) @db.Uuid
  disciplineId              String                     @db.Uuid
  categoryId                String?                    @db.Uuid
  key                       String
  label                     String
  description               String                     @default("")
  fieldType                 TechnicalFieldType
  unit                      String?
  unitFamily                String?
  allowedUnitsJson          Json?
  optionsJson               Json?
  validationJson            Json?
  isRequired                Boolean                    @default(false)
  isSearchable              Boolean                    @default(false)
  isFilterable              Boolean                    @default(false)
  isActive                  Boolean                    @default(true)
  applicableHierarchyNodeId String?                    @db.Uuid
  sortOrder                 Int                        @default(0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  discipline                MasterDiscipline           @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  category                  MasterCategory?            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  applicableHierarchyNode   MasterHierarchyNode?       @relation(fields: [applicableHierarchyNodeId], references: [id], onDelete: SetNull)
  attributeValues           MasterItemAttributeValue[]

  @@index([disciplineId])
  @@index([applicableHierarchyNodeId])
  @@index([categoryId])
}

/// MASTER-BOQ-1A — generic self-referential classification tree node.
/// Industry -> Discipline -> System -> Category -> Subcategory -> Item Family
/// all live here as MasterHierarchyNodeType-tagged rows instead of one table
/// per level, so a new industry/discipline never needs a migration. Cycle
/// prevention is enforced in master-hierarchy-service.ts (not expressible as
/// a Postgres constraint on a self-referential adjacency list).
model MasterHierarchyNode {
  id               String                     @id @default(uuid()) @db.Uuid
  code             String                     @unique
  name             String
  description      String                     @default("")
  nodeType         MasterHierarchyNodeType
  parentId         String?                    @db.Uuid
  regionScope      MasterRegionScope?
  isActive         Boolean                    @default(true)
  sortOrder        Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  parent           MasterHierarchyNode?       @relation("MasterHierarchyParent", fields: [parentId], references: [id], onDelete: Restrict)
  children         MasterHierarchyNode[]      @relation("MasterHierarchyParent")
  items            MasterItem[]
  fieldDefinitions TechnicalFieldDefinition[]
  productSeries    ProductSeries[]

  @@index([parentId])
  @@index([nodeType])
  @@index([isActive])
}

/// Published master items are never destructively overwritten — a BOQ line
/// snapshots the exact version it used (see BOQItem.sourceMasterItemVersionId
/// below), and later edits to the master item never retroactively change a
/// locked historical BOQ.
model MasterItemVersion {
  id                    String                     @id @default(uuid()) @db.Uuid
  masterItemId          String                     @db.Uuid
  versionNumber         Int
  status                MasterItemVersionStatus    @default(DRAFT)
  effectiveDate         DateTime?
  supersededDate        DateTime?
  changeSummary         String                     @default("")
  name                  String
  shortDescription      String                     @default("")
  fullDescription       String                     @default("")
  specificationTemplate String                     @default("")
  inclusionTemplate     String                     @default("")
  exclusionTemplate     String                     @default("")
  notesTemplate         String                     @default("")
  primaryUnit           String
  measurementMethod     String                     @default("")
  quantityBasis         String                     @default("")
  roundingRule          String                     @default("")
  wasteFactorPercentage Decimal?                   @db.Decimal(7, 4)
  packageMultiple       Decimal?                   @db.Decimal(12, 4)
  createdByUserId       String?                    @db.Uuid
  reviewedByUserId      String?                    @db.Uuid
  approvedByUserId      String?                    @db.Uuid
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  masterItem            MasterItem                 @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
  createdByUser         User?                      @relation("MasterItemVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedByUser        User?                      @relation("MasterItemVersionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedByUser        User?                      @relation("MasterItemVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  attributeValues       MasterItemAttributeValue[]
  boqItems              BOQItem[]
  productModels         ProductModel[]

  @@unique([masterItemId, versionNumber])
  @@index([masterItemId])
  @@index([status])
}

/// The leaf level below Master Item in the hierarchy example ("10,000 CFM
/// Chilled-Water Double-Skin Variant"). Kept minimal — identity + status
/// only — since assemblies/full variant configuration are out of scope for
/// this phase.
model MasterItemVariant {
  id              String                     @id @default(uuid()) @db.Uuid
  masterItemId    String                     @db.Uuid
  code            String
  name            String
  description     String                     @default("")
  isActive        Boolean                    @default(true)
  sortOrder       Int                        @default(0)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  masterItem      MasterItem                 @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
  attributeValues MasterItemAttributeValue[]

  @@unique([masterItemId, code])
  @@index([masterItemId])
}

/// The "Attribute Value" half of the definition+value pattern (definitions
/// live on the existing TechnicalFieldDefinition model above). Typed columns
/// rather than a single JSON blob so searchable/filterable values stay
/// queryable. Exactly one of masterItemId/variantId is expected to be set —
/// enforced in master-attribute-service.ts, not at the DB level.
model MasterItemAttributeValue {
  id                  String                           @id @default(uuid()) @db.Uuid
  masterItemId        String?                          @db.Uuid
  variantId           String?                          @db.Uuid
  fieldDefinitionId   String                           @db.Uuid
  valueText           String?
  valueNumber         Decimal?                         @db.Decimal(20, 6)
  valueBoolean        Boolean?
  valueDate           DateTime?
  unit                String?
  source              String                           @default("")
  verificationState   MasterAttributeVerificationState @default(UNVERIFIED)
  masterItemVersionId String?                          @db.Uuid
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  masterItem          MasterItem?                      @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
  variant             MasterItemVariant?               @relation(fields: [variantId], references: [id], onDelete: Cascade)
  fieldDefinition     TechnicalFieldDefinition         @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  masterItemVersion   MasterItemVersion?               @relation(fields: [masterItemVersionId], references: [id], onDelete: SetNull)

  @@index([masterItemId])
  @@index([variantId])
  @@index([fieldDefinitionId])
}

/// A mapping model (rather than fixed MasterFormat/OmniClass/... columns on
/// MasterItem) since not every item has every classification, and new
/// classification systems can be added without a migration.
model MasterItemClassification {
  id           String                     @id @default(uuid()) @db.Uuid
  masterItemId String                     @db.Uuid
  system       MasterClassificationSystem
  code         String
  label        String                     @default("")
  version      String                     @default("")
  isPrimary    Boolean                    @default(false)
  source       String                     @default("")
  isVerified   Boolean                    @default(false)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  masterItem   MasterItem                 @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  @@unique([masterItemId, system, code])
  @@index([masterItemId])
  @@index([system])
}

model MasterItemRegionalApplicability {
  id                       String            @id @default(uuid()) @db.Uuid
  masterItemId             String            @db.Uuid
  scope                    MasterRegionScope
  /// Empty string (not null) for scope-only rows (UAE/GCC/INTERNATIONAL) so
  /// the compound unique constraint below has a well-defined value —
  /// Prisma's generated compound-unique lookup type does not accept null.
  countryCode              String            @default("")
  effectiveFrom            DateTime?
  effectiveTo              DateTime?
  languageAvailabilityJson Json?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  masterItem               MasterItem        @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  @@unique([masterItemId, scope, countryCode])
  @@index([masterItemId])
}

/// The clean data contract for future drawing/BIM matching — not the
/// matching logic itself. One profile per item.
model MasterItemDrawingProfile {
  id                 String                @id @default(uuid()) @db.Uuid
  masterItemId       String                @unique @db.Uuid
