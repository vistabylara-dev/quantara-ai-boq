model SoftwarePlan {
  id                   String                        @id @default(uuid()) @db.Uuid
  key                  String                        @unique
  name                 String
  description          String                        @default("")
  planType             PlanType
  monthlyPrice         Decimal                       @default(0) @db.Decimal(12, 2)
  annualPrice          Decimal                       @default(0) @db.Decimal(12, 2)
  currency             String                        @default("USD")
  maxUsers             Int?
  maxProjects          Int?
  maxActiveBoqs        Int?
  maxDocumentsPerMonth Int?
  maxStorageBytes      BigInt?
  featuresJson         Json?
  isActive             Boolean                       @default(true)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  subscriptions        CompanySoftwareSubscription[]

  @@index([planType])
  @@index([isActive])
}

model CompanySoftwareSubscription {
  id                     String                   @id @default(uuid()) @db.Uuid
  companyId              String                   @db.Uuid
  softwarePlanId         String                   @db.Uuid
  status                 SubscriptionStatus
  trialStartedAt         DateTime?
  trialExpiresAt         DateTime?
  startsAt               DateTime?
  expiresAt              DateTime?
  cancelledAt            DateTime?
  externalSubscriptionId String?
  source                 String                   @default("development")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  softwarePlan           SoftwarePlan             @relation(fields: [softwarePlanId], references: [id], onDelete: Restrict)
  trialUsage             CompanyTrialUsage[]
  trialPremiumUnlocks    TrialPremiumItemUnlock[]

  @@index([companyId])
  @@index([softwarePlanId])
  @@index([status])
}

model CompanyTrialUsage {
  id                         String                      @id @default(uuid()) @db.Uuid
  companyId                  String                      @db.Uuid
  subscriptionId             String                      @db.Uuid
  projectsCreated            Int                         @default(0)
  boqsCompleted              Int                         @default(0)
  documentsGenerated         Int                         @default(0)
  proposalsCreated           Int                         @default(0)
  uniquePremiumItemsUnlocked Int                         @default(0)
  firstUsedAt                DateTime?
  lastUsedAt                 DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription               CompanySoftwareSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([companyId, subscriptionId])
  @@index([companyId])
  @@index([subscriptionId])
