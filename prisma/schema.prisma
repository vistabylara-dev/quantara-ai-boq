  updatedAt          DateTime              @updatedAt
  masterItem         MasterItem            @relation(fields: [masterItemId], references: [id], onDelete: Cascade)
}

/// Deliberately empty of data for now — the smallest expandable contract for
/// future assemblies/methodology (required/optional accessories, materials,
/// labor, testing, commissioning, substitution).
model MasterItemRelation {
  id           String                 @id @default(uuid()) @db.Uuid
  fromItemId   String                 @db.Uuid
  toItemId     String                 @db.Uuid
