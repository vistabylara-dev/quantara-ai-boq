  childCategories  MasterCategory[]           @relation("CategoryParent")
  items            MasterItem[]
  fieldDefinitions TechnicalFieldDefinition[]
  libraryItems     CompanyLibraryItem[]

  @@index([disciplineId])
  @@index([parentCategoryId])
  @@index([path])
