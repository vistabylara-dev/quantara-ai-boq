  /// a point-in-time snapshot of classification/attributes/region that don't
  /// otherwise have a dedicated column here. Editing this line never mutates
  /// the master item; a later master-item edit never mutates this line.
  sourceMasterItemVersionId  String?                 @db.Uuid
  masterItemSnapshotJson     Json?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  company                    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  section                    BOQSection              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options                    BOQItemOption[]
  verificationExceptions     VerificationException[]
  sourceMasterItem           MasterItem?             @relation(fields: [sourceMasterItemId], references: [id], onDelete: SetNull)
  sourceMasterItemVersion    MasterItemVersion?      @relation(fields: [sourceMasterItemVersionId], references: [id], onDelete: SetNull)
