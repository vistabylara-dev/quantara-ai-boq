late-900 dark:text-slate-300 dark:hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 rounded-md"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-menu h-6 w-6","aria-hidden":"true"},["line",{"x1":"4","x2":"20","y1":"12","y2":"12"}],["line",{"x1":"4","x2":"20","y1":"6","y2":"6"}],["line",{"x1":"4","x2":"20","y1":"18","y2":"18"}]]]]],["MAIN",{"class":"flex-1"},["DIV",{"class":"w-full bg-white text-slate-900 font-sans"},["DIV",{"class":"flex-1 w-full max-w-4xl mx-auto px-4 py-12 md:py-20"},["NAV",{"aria-label":"Breadcrumb","class":"mb-8 text-sm"},["OL",{"class":"flex items-center gap-2 flex-wrap"},["LI",{},["A",{"class":"text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors","href":"/"},"Home"]],["LI",{"class":"text-slate-400 dark:text-slate-600","aria-hidden":"true"},"/"],["LI",{},["A",{"class":"text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors","href":"/resources"},"Resources"]],["LI",{"class":"text-slate-400 dark:text-slate-600","aria-hidden":"true"},"/"],["LI",{},["SPAN",{"class":"text-slate-900 dark:text-white font-medium","aria-current":"page"},"How to Convert a PDF BOQ to Excel with Structured Review"]]]],["ARTICLE",{},["HEADER",{"class":"mb-12"},["H1",{"class":"text-4xl md:text-5xl font-bold text-slate-900 tracking-tight leading-tight mb-6"},"How to Convert a PDF BOQ to Excel with Structured Review"],["DIV",{"class":"bg-slate-50 border border-slate-100 rounded-xl p-6 md:p-8"},["P",{"class":"text-lg text-slate-700 leading-relaxed font-medium"},"Contractors frequently receive Bills of Quantities in PDF format, making them impossible to price directly. Converting a PDF BOQ to an editable Excel or digital format is a necessary workflow, but doing it safely requires careful attention to table structures, text recognition, and human verification."]]],["DIV",{"class":"prose prose-slate prose-lg max-w-none"},["SECTION",{"id":"why-it-matters","class":"mb-12 scroll-mt-24"},["H2",{"class":"text-2xl md:text-3xl font-bold text-slate-900 mb-6"},"Why Safe Conversion Matters"],["P",{"class":"text-slate-600 leading-relaxed mb-4"},"For estimating teams, blindly trusting a PDF-to-Excel conversion tool is a massive commercial risk. Automated converters often scramble merged cells, drop decimal points, or mix item descriptions with quantities."],["P",{"class":"text-slate-600 leading-relaxed mb-4"},"A structured conversion and review process ensures the resulting pricing document is 100% faithful to the client's original intent."]],["SECTION",{"id":"the-workflow","class":"mb-12 scroll-mt-24"},["H2",{"class":"text-2xl md:text-3xl font-bold text-slate-900 mb-6"},"Safe Conversion Workflow"],["OL",{"class":"list-decimal pl-6 mb-6 text-slate-600 space-y-2"},["LI",{},"Identify the document type: Determine if you have a native text PDF (generated directly from software) or an image-based scanned PDF."],["LI",{},"Confirm correct version: Ensure you are converting the latest issued revision."],["LI",{},"Extract tables: Use dedicated extraction software to lift the tabular data into a spreadsheet format."],["LI",{},"Map columns: Ensure Item Number, Description, Quantity, and Unit columns align correctly."],["LI",{},"Review merged cells: Fix headers and descriptions that spanned multiple rows and were broken during extraction."],["LI",{},"Identify page breaks: Remove repeating page headers and footers that interrupted the data flow."],["LI",{},"Inspect quantities and units: Check for missing decimal points or misaligned columns."],["LI",{},"Correct OCR issues: If the document was a scan, manually verify numbers and symbols."],["LI",{},"Validate formulas: Rebuild and test SUM formulas to ensure section totals match the PDF summary page."],["LI",{},"Save a controlled copy: Lock the structure so estimators can only edit the rate columns."],["LI",{},"Professionally review the result: Have a qualified person sign off on the converted file before pricing begins."]]],["SECTION",{"id":"practical-example","class":"mb-12 scroll-mt-24"},["H2",{"class":"text-2xl md:text-3xl font-bold text-slate-900 mb-6"},"A Practical Example"],["P",{"class":"text-slate-600 leading-relaxed mb-4"},"A hypothetical contractor receives a 50-page PDF BOQ for a school construction project."],["P",{"class":"text-slate-600 leading-relaxed mb-4"},"Using a generic online converter, the text \"100.00\" in the quantity column is misread as \"10000\" because the decimal point was faded. Without the structured review workflow (Step 7 and 11), the contractor would overprice that item by 100x."]],["SECTION",{"id":"limitations","class":"mb-12 scroll-mt-24"},["H2",{"class":"text-2xl md:text-3xl font-bold text-slate-900 mb-6"},"Limitations of Conversion"],["P",{"class":"text-slate-600 leading-relaxed mb-4"},"Do not claim or expect perfect, instant conversion. Complex documents with nested tables, handwritten notes, or poor scan quality will always require manual intervention."],["P",{"class":"text-slate-600 leading-relaxed mb-4"},"The goal of software is to do the heavy lifting, but human oversight is mandatory."]],["SECTION",{"id":"quantara-workflow","class":"mb-12 scroll-mt-24"},["H2",{"class":"text-2xl md:text-3xl font-bold text-slate-900 mb-6"},"How Quantara Enhances Extraction"],["P",{"class":"text-slate-600 leading-relaxed mb-4"},"Quantara is specifically designed to handle BOQ document extraction. Rather than just dumping unstructured text into Excel, it uses AI-assisted processing to understand the structure of construction items, drastically reducing the manual cleanup required."],["P",{"class":"text-slate-600 leading-relaxed mb-4"},"Quantara currently focuses on supported document extraction, BOQ structuring, project organization, templates, revisions, and professional outputs."]]],["HR",{"class":"my-12 border-slate-200"}],["SECTION",{"class":"bg-slate-50 border border-slate-200 rounded-xl p-6 mb-12"},["H2",{"class":"text-xl font-bold text-slate-900 mb-3"},"Professional Disclaimer"],["P",{"class":"text-slate-600 text-sm leading-relaxed"},"This information is provided for general educational purposes and does not replace project-specific advice or professional judgment. Quantities, units, specifications, rates, assumptions, exclusions and project documents must be reviewed by an appropriately qualified construction professional before tender, procurement, contractual or construction use."]],["SECTION",{"class":"mb-16"},["H2",{"class":"text-3xl font-bold text-slate-900 mb-8"},"Frequently Asked Questions"],["DIV",{"class":"space-y-4"},["DETAILS",{"class":"group bg-white border border-slate-200 rounded-lg [&_summary::-webkit-details-marker]:hidden"},["SUMMARY",{"class":"flex cursor-pointer items-center justify-between gap-1.5 p-6 text-slate-900 font-medium"},"Why do clients send BOQs as PDFs?",["SPAN",{"class":"shrink-0 rounded-full bg-slate-100 p-1.5 text-slate-900 sm:p-3 group-open:-rotate-180 transition-transform"},["svg",{"xmlns":"http://www.w3.org/2000/svg","class":"h-5 w-5","viewBox":"0 0 20 20","fill":"currentColor"},["path",{"fill-rule":"evenodd","d":"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z","clip-rule":"evenodd"}]]]],["DIV",{"class":"px-6 pb-6 text-slate-600"},["P",{},"Clients issue PDFs to prevent contractors from easily altering the item descriptions, quantities, or formulas, ensuring all bids are submitted on an identical baseline."]]],["DETAILS",{"class":"group bg-white border border-slate-200 rounded-lg [&_summary::-webkit-details-marker]:hidden"},["SUMMARY",{"class":"flex cursor-pointer items-center justify-between gap-1.5 p-6 text-slate-900 font-medium"},"Can all PDFs be converted?",["SPAN",{"class":"shrink-0 rounded-full bg-slate-100 p-1.5 text-slate-900 sm:p-3 group-open:-rotate-180 transition-transform"},["svg",{"xmlns":"http://www.w3.org/2000/svg","class":"h-5 w-5","viewBox":"0 0 20 20","fill":"currentColor"},["path",{"fill-rule":"evenodd","d":"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z","clip-rule":"evenodd"}]]]],["DIV",{"class":"px-6 pb-6 text-slate-600"},["P",{},"Native text PDFs can usually be extracted cleanly. Scanned image PDFs require OCR and are much harder to convert accurately."]]],["DETAILS",{"class":"group bg-white border border-slate-200 rounded-lg [&_summary::-webkit-details-marker]:hidden"},["SUMMARY",{"class":"flex cursor-pointer items-center justify-between gap-1.5 p-6 text-slate-900 font-medium"},"What is a merged cell error?",["SPAN",{"class":"shrink-0 rounded-full bg-slate-100 p-1.5 text-slate-900 sm:p-3 group-open:-rotate-180 transition-transform"},["svg",{"xmlns":"http://www.w3.org/2000/svg","class":"h-5 w-5","viewBox":"0 0 20 20","fill":"currentColor"},["path",{"fill-rule":"evenodd","d":"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z","clip-rule":"evenodd"}]]]],["DIV",{"class":"px-6 pb-6 text-slate-600"},["P",{},"When a long item description spans multiple rows in a PDF, basic converters often chop the text into separate Excel rows, breaking the BOQ structure."]]],["DETAILS",{"class":"group bg-white border border-slate-200 rounded-lg [&_summary::-webkit-details-marker]:hidden"},["SUMMARY",{"class":"flex cursor-pointer items-center justify-between gap-1.5 p-6 text-slate-900 font-medium"},"How long does manual conversion take?",["SPAN",{"class":"shrink-0 rounded-full bg-slate-100 p-1.5 text-slate-900 sm:p-3 group-open:-rotate-180 transition-transform"},["svg",{"xmlns":"http://www.w3.org/2000/svg","class":"h-5 w-5","viewBox":"0 0 20 20","fill":"currentColor"},["path",{"fill-rule":"evenodd","d":"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z","clip-rule":"evenodd"}]]]],["DIV",{"class":"px-6 pb-6 text-slate-600"},["P",{},"Retyping a complex 100-page BOQ can take an estimator several days. Extraction software reduces this, but review time must still be scheduled."]]],["DETAILS",{"class":"group bg-white border border-slate-200 rounded-lg [&_summary::-webkit-details-marker]:hidden"},["SUMMARY",{"class":"flex cursor-pointer items-center justify-between gap-1.5 p-6 text-slate-900 font-medium"},"Do I need to rebuild formulas in Excel?",["SPAN",{"class":"shrink-0 rounded-full bg-slate-100 p-1.5 text-slate-900 sm:p-3 group-open:-rotate-180 transition-transform"},["svg",{"xmlns":"http://www.w3.org/2000/svg","class":"h-5 w-5","viewBox":"0 0 20 20","fill":"currentColor"},["path",{"fill-rule":"evenodd","d":"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z","clip-rule":"evenodd"}]]]],["DIV",{"class":"px-6 pb-6 text-slate-600"},["P",{},"Yes. PDFs do not contain embedded spreadsheet formulas. Once the data is in Excel, you must manually recreate the =A1*B1 rate and quantity math."]]]]],["SECTION",{"class":"mb-16"},["H2",{"class":"text-2xl font-bold text-slate-900 mb-6"},"Related Reading"],["DIV",{"class":"grid md:grid-cols-2 gap-4"},["A",{"class":"group block p-6 bg-slate-50 border border-slate-200 rounded-xl hover:border-blue-300 hover:bg-blue-50/50 transition-all","href":"/pdf-boq-extraction"},["H3",{"class":"font-semibold text-slate-900 group-hover:text-blue-700 mb-2 flex items-center justify-between"},"PDF BOQ Extraction Software",["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-arrow-right w-4 h-4 opacity-0 group-hover:opacity-100 transform -translate-x-2 group-hover:translate-x-0 transition-all"},["path",{"d":"M5 12h